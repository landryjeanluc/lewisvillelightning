---
import Base from "../layouts/Base.astro";
---
<Base title="Your account">
  <h1>Your account</h1>
  <p id="account-loading" role="status">Checking your session…</p>
  <p id="account-gate" hidden>Your session has ended. <a href="/login?next=/account">Sign in</a></p>
  <section id="account-content" class="card account" hidden>
    <h2 id="account-name"></h2>
    <p id="account-handle" class="dim"></p>
    <form id="password-form">
      <h3>Change your password</h3>
      <p>Use at least 8 characters. Changing your password signs out your other devices.</p>
      <label>Current password<input name="current" type="password" required autocomplete="current-password" /></label>
      <label>New password<input name="new" type="password" required minlength="8" autocomplete="new-password" /></label>
      <label>Confirm new password<input name="confirm" type="password" required minlength="8" autocomplete="new-password" /></label>
      <button type="submit">Change password</button>
    </form>
    <p id="account-status" role="status" aria-live="polite"></p>
    <button id="account-logout" type="button" class="ghost">Sign out on all devices</button>
  </section>
</Base>
<script>
  import { postAuth } from "../scripts/auth-form";
  const content = document.getElementById("account-content")!;
  const loading = document.getElementById("account-loading")!;
  const gate = document.getElementById("account-gate")!;
  const status = document.getElementById("account-status")!;
  const form = document.getElementById("password-form") as HTMLFormElement;
  const logout = document.getElementById("account-logout") as HTMLButtonElement;
  async function boot() {
    try {
      const response = await fetch("/api/auth/me", {credentials:"same-origin", cache:"no-store", signal:AbortSignal.timeout(15000)});
      if (!response.ok) throw new Error();
      const user = await response.json();
      loading.hidden = true;
      if (!user) { gate.hidden = false; return; }
      document.getElementById("account-name")!.textContent = user.display_name;
      document.getElementById("account-handle")!.textContent = `Sign-in: ${user.email}`;
      content.hidden = false;
    } catch { loading.textContent = "Could not check your session. Please reload to try again."; }
  }
  form.addEventListener("submit", async event => {
    event.preventDefault();
    const data = new FormData(form);
    if (data.get("new") !== data.get("confirm")) { status.textContent = "The new passwords do not match."; return; }
    const button = form.querySelector("button")!;
    button.disabled = true;
    const result = await postAuth("change-password", {current:data.get("current"), new:data.get("new")});
    button.disabled = false;
    status.textContent = result.ok ? "Password changed. Your other devices have been signed out." : result.detail;
    if (result.ok) form.reset();
  });
  logout.addEventListener("click", async () => {
    logout.disabled = true;
    const result = await postAuth("logout", {});
    if (result.ok) {
      try { sessionStorage.removeItem("lvlnb.play-draft.v1"); localStorage.removeItem("lvlnb.play-draft.v1"); } catch { /* storage unavailable */ }
      location.replace("/login");
    } else { status.textContent = result.detail; logout.disabled = false; }
  });
  void boot();
</script>
<style>
  .account { max-width: 38rem; padding: var(--s-5); }
  form { display: grid; gap: var(--s-3); }
  label { display: grid; gap: var(--s-1); }
  input { width: 100%; min-height: 44px; }
</style>
