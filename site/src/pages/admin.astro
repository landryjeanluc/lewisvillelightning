---
import Base from "../layouts/Base.astro";
import NewsPanel from "../components/admin/NewsPanel.astro";
import RosterPanel from "../components/admin/RosterPanel.astro";
import NotesPanel from "../components/admin/NotesPanel.astro";
import JobsPanel from "../components/admin/JobsPanel.astro";
import ModerationPanel from "../components/admin/ModerationPanel.astro";
import { roster, games, sides } from "../lib/data";

// Roster and fixtures are build-time data; only the stats themselves are live.
const players = [...roster.players].sort((a: any, b: any) => a.number - b.number);
const gameList = games.map((g: any) => {
  const s = sides(g);
  return { id: g.id, label: `${s.weAreHome ? "vs" : "at"} ${s.them.short}`, date: g.startsAt.slice(0, 10) };
}).reverse();
---
<Base title="Admin">
  <header class="page-head">
    <span class="eyebrow">Team admin</span>
    <h1>Scoresheet</h1>
  </header>

  <div id="gate" class="gate">
    <form id="login" class="card login">
      <p class="dim">Sign in with your admin account to record game stats.</p>
      <label>Email<input type="email" name="email" autocomplete="username" required /></label>
      <label>Password<input type="password" name="password" autocomplete="current-password" required /></label>
      <button type="submit">Sign in</button>
      <p id="loginerr" class="err" hidden></p>
    </form>
  </div>

  <div id="viewer" class="card note" hidden>
    <p>You're signed in as <strong id="viewername"></strong> with read access.
       Only admins can record stats — ask JL to change your role.</p>
    <button type="button" class="link" data-logout>Sign out</button>
  </div>

  <div id="editor" hidden>
    <nav class="tabs" role="tablist">
      <button type="button" class="tab is-on" data-tab="sheet-tab" role="tab">Scoresheet</button>
      <button type="button" class="tab" data-tab="news-tab"   role="tab">News</button>
      <button type="button" class="tab" data-tab="roster-tab" role="tab">Roster</button>
      <button type="button" class="tab" data-tab="notes-tab"  role="tab">Coach's notes</button>
      <button type="button" class="tab" data-tab="jobs-tab"       role="tab">Game jobs</button>
      <button type="button" class="tab" data-tab="moderation-tab" role="tab">Review</button>
      <button type="button" class="tab" data-tab="people-tab"     role="tab">Team access</button>
    </nav>

    <section id="sheet-tab">
    <div class="bar card">
      <label class="pick">Game
        <select id="game">
          {gameList.map((g) => <option value={g.id}>{g.date} — {g.label}</option>)}
        </select>
      </label>
      <div class="score">
        <label>Us<input id="ourScore" type="number" inputmode="numeric" min="0" /></label>
        <label>Them<input id="theirScore" type="number" inputmode="numeric" min="0" /></label>
      </div>
      <span class="who dim">Signed in as <strong id="adminname"></strong> ·
        <button type="button" class="link" data-logout>Sign out</button></span>
    </div>

    <div class="tablewrap card">
      <table id="sheet">
        <thead>
          <tr><th class="l">Player</th><th>G</th><th>A</th><th>PIM</th><th>+/−</th></tr>
        </thead>
        <tbody>
          {players.map((p: any) => (
            <tr data-player={p.id}>
              <td class="l"><span class="jn num">{p.number}</span>{p.firstName} {p.lastName}</td>
              <td><input type="number" inputmode="numeric" min="0" data-f="g" value="0" /></td>
              <td><input type="number" inputmode="numeric" min="0" data-f="a" value="0" /></td>
              <td><input type="number" inputmode="numeric" min="0" data-f="pim" value="0" /></td>
              <td><input type="number" inputmode="numeric" data-f="plus_minus" value="0" /></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="actions">
      <span id="status" class="dim"></span>
      <button id="save" type="button">Save scoresheet</button>
    </div>
    </section>

    <section id="news-tab" hidden><NewsPanel /></section>
    <section id="roster-tab" hidden><RosterPanel /></section>
    <section id="notes-tab" hidden><NotesPanel /></section>

    <section id="jobs-tab" hidden><JobsPanel /></section>
    <section id="moderation-tab" hidden><ModerationPanel /></section>

    <section id="people-tab" hidden>
      <div class="tablewrap card">
        <table>
          <thead>
            <tr><th class="l">Person</th><th class="l">Email</th><th>Role</th><th>Last login</th><th></th></tr>
          </thead>
          <tbody id="people"></tbody>
        </table>
      </div>

      <form id="adduser" class="card adduser">
        <h3>Add someone</h3>
        <div class="fields">
          <label>Name<input name="display_name" required autocomplete="off" /></label>
          <label>Email<input name="email" type="email" required autocomplete="off" /></label>
          <label>Password<input name="password" type="password" required minlength="8" autocomplete="new-password" /></label>
          <label>Role
            <select name="role">
              <option value="viewer">Viewer — can read</option>
              <option value="admin">Admin — can record stats</option>
            </select>
          </label>
        </div>
        <div class="actions">
          <span id="peoplestatus" class="dim"></span>
          <button type="submit">Add account</button>
        </div>
      </form>
    </section>
  </div>
</Base>

<script>
  const $ = (s: string) => document.querySelector(s) as any;
  const API = "/api";
  let dirty = false;

  const api = async (path: string, opts: any = {}) => {
    const r = await fetch(API + path, {
      credentials: "same-origin",
      headers: { "content-type": "application/json" },
      ...opts,
    });
    return { ok: r.ok, status: r.status, body: await r.json().catch(() => null) };
  };

  function show(which: "gate" | "viewer" | "editor", user?: any) {
    for (const id of ["gate", "viewer", "editor"]) $("#" + id).hidden = id !== which;
    if (user) {
      $("#viewername").textContent = user.display_name;
      $("#adminname").textContent = user.display_name;
    }
  }

  async function boot() {
    const { body: user } = await api("/auth/me");
    if (!user) return show("gate");
    if (user.role !== "admin") return show("viewer", user);
    show("editor", user);
    await loadGame();
  }

  async function loadGame() {
    const id = $("#game").value;
    $("#status").textContent = "Loading…";
    const { ok, body } = await api(`/stats/game/${id}`);
    // reset every row first so a game with no sheet doesn't inherit the last one
    document.querySelectorAll("#sheet tbody tr").forEach((tr: any) => {
      tr.querySelectorAll("input").forEach((i: any) => (i.value = "0"));
    });
    $("#ourScore").value = ""; $("#theirScore").value = "";
    if (ok && body) {
      if (body.result) {
        $("#ourScore").value = body.result.our_score ?? "";
        $("#theirScore").value = body.result.their_score ?? "";
      }
      for (const line of body.lines ?? []) {
        const tr = document.querySelector(`#sheet tr[data-player="${line.player_id}"]`);
        if (!tr) continue;
        for (const f of ["g", "a", "pim", "plus_minus"]) {
          (tr.querySelector(`[data-f="${f}"]`) as any).value = line[f] ?? 0;
        }
      }
    }
    dirty = false;
    $("#status").textContent = body?.result ? "Saved sheet loaded." : "No sheet recorded for this game yet.";
  }

  async function save() {
    const lines: any[] = [];
    document.querySelectorAll("#sheet tbody tr").forEach((tr: any) => {
      const n = (f: string) => Number(tr.querySelector(`[data-f="${f}"]`).value || 0);
      const line = { player_id: tr.dataset.player, g: n("g"), a: n("a"), pim: n("pim"), plus_minus: n("plus_minus") };
      // only send players who actually did something — keeps the sheet honest
      if (line.g || line.a || line.pim || line.plus_minus) lines.push(line);
    });
    const num = (el: any) => (el.value === "" ? null : Number(el.value));
    $("#save").disabled = true;
    $("#status").textContent = "Saving…";
    const { ok, status, body } = await api(`/stats/game/${$("#game").value}`, {
      method: "PUT",
      body: JSON.stringify({
        our_score: num($("#ourScore")), their_score: num($("#theirScore")),
        status: "final", lines,
      }),
    });
    $("#save").disabled = false;
    if (!ok) {
      $("#status").textContent = status === 401 ? "Session expired — sign in again."
        : `Could not save (${status}). ${body?.detail ?? ""}`;
      if (status === 401) show("gate");
      return;
    }
    dirty = false;
    $("#status").textContent = `Saved ${body.saved} player${body.saved === 1 ? "" : "s"}.`
      + (body.warnings?.length ? ` Note: ${body.warnings.join("; ")}` : "");
  }

  const fmtDate = (s: string | null) =>
    s ? new Date(s).toLocaleDateString("en-CA", { month: "short", day: "numeric", year: "numeric" }) : "never";

  async function loadPeople() {
    const { ok, body } = await api("/users");
    const tb = $("#people");
    if (!ok) { tb.innerHTML = `<tr><td colspan="5" class="dim">Could not load accounts.</td></tr>`; return; }
    const meId = (await api("/auth/me")).body?.id;
    tb.innerHTML = "";
    for (const u of body) {
      const tr = document.createElement("tr");
      tr.innerHTML = `
        <td class="l">${u.display_name}${u.id === meId ? ' <span class="pill">you</span>' : ""}</td>
        <td class="l dim">${u.email}</td>
        <td>
          <select data-role="${u.id}">
            <option value="viewer"${u.role === "viewer" ? " selected" : ""}>Viewer</option>
            <option value="admin"${u.role === "admin" ? " selected" : ""}>Admin</option>
          </select>
        </td>
        <td class="dim">${fmtDate(u.last_login_at)}</td>
        <td class="row-actions">
          <button type="button" class="link" data-pw="${u.id}">Reset password</button>
          <button type="button" class="link danger" data-del="${u.id}" data-name="${u.display_name}">Remove</button>
        </td>`;
      tb.appendChild(tr);
    }
  }

  const peopleSay = (m: string) => ($("#peoplestatus").textContent = m);

  document.addEventListener("change", async (e: any) => {
    const id = e.target.dataset?.role;
    if (!id) return;
    const { ok, status, body } = await api(`/users/${id}`, {
      method: "PATCH", body: JSON.stringify({ role: e.target.value }),
    });
    // 409 is the only-admin guard: say exactly that, and put the select back.
    peopleSay(ok ? "Role updated." : body?.detail ?? `Could not change role (${status}).`);
    loadPeople();
  });

  document.addEventListener("click", async (e: any) => {
    const pw = e.target.dataset?.pw;
    const del = e.target.dataset?.del;
    if (pw) {
      const next = prompt("New password (at least 8 characters):");
      if (!next) return;
      const { ok, body } = await api(`/users/${pw}`, {
        method: "PATCH", body: JSON.stringify({ password: next }),
      });
      peopleSay(ok ? "Password reset." : body?.detail ?? "Could not reset password.");
      return;
    }
    if (del) {
      if (!confirm(`Remove ${e.target.dataset.name}? Stats they entered are kept.`)) return;
      const { ok, body } = await api(`/users/${del}`, { method: "DELETE" });
      peopleSay(ok ? "Account removed." : body?.detail ?? "Could not remove account.");
      loadPeople();
    }
  });

  $("#adduser").addEventListener("submit", async (e: Event) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const f = new FormData(form);
    const { ok, body } = await api("/users", {
      method: "POST",
      body: JSON.stringify({
        display_name: f.get("display_name"), email: f.get("email"),
        password: f.get("password"), role: f.get("role"),
      }),
    });
    if (!ok) {
      // pydantic 422 returns a list of issues; show the first message
      const d = body?.detail;
      peopleSay(Array.isArray(d) ? d[0]?.msg ?? "Invalid details." : d ?? "Could not add account.");
      return;
    }
    form.reset();
    peopleSay(`Added ${body.display_name}.`);
    loadPeople();
  });

  document.querySelectorAll(".tab").forEach((b: any) =>
    b.addEventListener("click", () => {
      document.querySelectorAll(".tab").forEach((x) => x.classList.remove("is-on"));
      b.classList.add("is-on");
      for (const id of ["sheet-tab", "news-tab", "roster-tab", "notes-tab",
                        "jobs-tab", "moderation-tab", "people-tab"])
        $("#" + id).hidden = b.dataset.tab !== id;
      if (b.dataset.tab === "people-tab") loadPeople();
    }));

  $("#login").addEventListener("submit", async (e: Event) => {
    e.preventDefault();
    const f = new FormData(e.target as HTMLFormElement);
    const { ok, body } = await api("/auth/login", {
      method: "POST",
      body: JSON.stringify({ email: f.get("email"), password: f.get("password") }),
    });
    const err = $("#loginerr");
    if (!ok) { err.textContent = body?.detail ?? "Sign in failed."; err.hidden = false; return; }
    err.hidden = true;
    boot();
  });

  document.querySelectorAll("[data-logout]").forEach((b) =>
    b.addEventListener("click", async () => { await api("/auth/logout", { method: "POST" }); show("gate"); }));

  $("#game").addEventListener("change", () => {
    if (dirty && !confirm("You have unsaved changes. Discard them?")) return;
    loadGame();
  });
  $("#save").addEventListener("click", save);
  document.addEventListener("input", (e: any) => { if (e.target.closest("#sheet, .score")) dirty = true; });
  window.addEventListener("beforeunload", (e) => { if (dirty) e.preventDefault(); });

  boot();
</script>

<style>
  /* `.login/.note { display: grid }` is a class selector and so outranks the UA
     stylesheet's `[hidden] { display: none }` — without this the viewer panel
     renders on top of the sign-in form. */
  [hidden] { display: none !important; }

  .page-head { margin-bottom: var(--s-6); }
  .page-head h1 { margin-top: var(--s-2); }

  .login, .note { padding: var(--s-5); max-width: 26rem; display: grid; gap: var(--s-4); }
  .err { color: var(--loss); font-size: var(--t-sm); }

  .bar { display: flex; flex-wrap: wrap; align-items: end; gap: var(--s-5);
         padding: var(--s-4); margin-bottom: var(--s-4); }
  .pick { flex: 1 1 16rem; }
  .score { display: flex; gap: var(--s-3); }
  .score input { width: 5rem; text-align: center; }
  .who { font-size: var(--t-sm); margin-left: auto; text-transform: none; letter-spacing: 0; }

  .tablewrap { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; min-width: 480px; }
  th { font-family: var(--font-ui); font-size: var(--t-micro); font-weight: 700;
       letter-spacing: var(--track-label); text-transform: uppercase; color: var(--text-dim);
       padding: var(--s-3); text-align: center; }
  th.l, td.l { text-align: left; }
  td { padding: var(--s-2) var(--s-3); border-top: 1px solid var(--hairline); }
  td.l { font-weight: 600; white-space: nowrap; }
  /* big tap targets — this gets filled in on a phone at the rink */
  td input { width: 4.25rem; text-align: center; padding: var(--s-3) var(--s-2); }
  .jn { display: inline-grid; place-items: center; width: 26px; height: 26px;
        margin-right: var(--s-3); font-size: var(--t-xs); color: var(--volt-300);
        background: var(--surface-2); border: 1px solid var(--hairline); border-radius: 5px; }

  .tabs { display: flex; gap: var(--s-2); margin-bottom: var(--s-4); }
  .tab {
    background: none; color: var(--text-dim); border: 1px solid var(--hairline);
    border-radius: var(--r-md); padding: var(--s-2) var(--s-4);
  }
  .tab.is-on { color: var(--text); border-color: var(--volt-500); background: var(--surface-2); }

  .adduser { padding: var(--s-5); margin-top: var(--s-4); display: grid; gap: var(--s-4); }
  .adduser h3 { font-size: var(--t-md); }
  .fields { display: grid; gap: var(--s-4); grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr)); }

  /* The people rows are built at runtime with innerHTML. Astro scopes component
     CSS with a build-time data-astro-cid-* attribute, which runtime nodes never
     get — so every rule that has to reach those rows must be :global(). Without
     this the row buttons render unstyled. */
  :global(#people td) { vertical-align: middle; padding: var(--s-2) var(--s-3);
                        border-top: 1px solid var(--hairline); }
  :global(#people td.l) { text-align: left; font-weight: 600; white-space: nowrap; }
  :global(#people td.dim) { color: var(--text-dim); font-weight: 500; }
  :global(#people select) { padding: var(--s-2); font-size: var(--t-sm); font-weight: 600;
                            color: var(--text); background: var(--bg-sunken);
                            border: 1px solid var(--hairline-sv); border-radius: var(--r-md); }
  :global(#people .row-actions) { display: flex; gap: var(--s-4);
                                  justify-content: flex-end; white-space: nowrap; }
  :global(#people button.link) { background: none; border: 0; padding: 0; cursor: pointer;
                                 color: var(--accent-text); font-family: var(--font-ui);
                                 font-size: var(--t-sm); font-weight: 600;
                                 text-transform: none; letter-spacing: 0; }
  :global(#people button.link.danger) { color: var(--loss); }
  :global(#people .pill) { margin-left: var(--s-2); }

  .actions { display: flex; align-items: center; justify-content: space-between;
             gap: var(--s-4); margin-top: var(--s-5); flex-wrap: wrap; }
  @media (max-width: 520px) {
    .bar { flex-direction: column; align-items: stretch; }
    .who { margin-left: 0; }
    .actions { flex-direction: column-reverse; align-items: stretch; }
    .actions button { width: 100%; }
  }
</style>
