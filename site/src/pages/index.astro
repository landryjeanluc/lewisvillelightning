---
import Base from "../layouts/Base.astro";
import Matchup from "../components/Matchup.astro";
import EventRow from "../components/EventRow.astro";
import EmptyState from "../components/EmptyState.astro";
import TeamShowcase from "../components/TeamShowcase.astro";
import AddToCalendar from "../components/AddToCalendar.astro";
import Countdown from "../components/Countdown.astro";
import Lightning from "../components/Lightning.astro";
import PlayerCard from "../components/PlayerCard.astro";
import HomeGoals from "../components/HomeGoals.astro";
import NewsFeed from "../components/NewsFeed.astro";
import InstallApp from "../components/InstallApp.astro";
import { displayName, team, nextGame, nextPractice, upcoming, results, sides, spotlightFor, spotlightProgress } from "../lib/data";
import { longDate, time, relativeDay, machine, shortDate } from "../lib/format";

const g = nextGame();
const p = nextPractice();
const up = upcoming().filter((e: any) => e.id !== g?.id);
const recent = results();
const s = g ? sides(g) : null;
const star = g ? spotlightFor(g.id) : undefined;
const rot = spotlightProgress();
---
<Base wide>
  <HomeGoals slot="header-footer" />

  {g ? (
    <section class="hero">
      <Lightning />
      <div class="hero-top">
        <span class="eyebrow">{team.level} {team.division} · {g.gameType === "regular" ? "Regular season" : g.gameType === "exhibition" ? "Exhibition" : g.gameType}</span>
        <h1 class="display--italic hero-title">{relativeDay(g.startsAt) === "Today" ? "Game Day" : "Next Game"}</h1>
      </div>

      <Matchup game={g} />

      <div class="hero-cd"><Countdown iso={g.startsAt} /></div>

      <div class="hero-info">
        <div class="info">
          <span class="eyebrow">Date</span>
          <time datetime={machine(g.startsAt)}>{longDate(g.startsAt)}</time>
        </div>
        <div class="info info--feature">
          <span class="eyebrow">Puck drop</span>
          <span class="big num">{time(g.startsAt)}</span>
        </div>
        <div class="info">
          <span class="eyebrow">{s!.weAreHome ? "Home ice" : "Away rink"}</span>
          <span>{g.venue.name}</span>
        </div>
      </div>

      <div class="hero-actions">
        <a class="cta" href={`/schedule/${g.id}`}>Game details</a>
        <AddToCalendar event={g} />
      </div>
    </section>
  ) : (
    <section class="hero hero--empty">
      <h1>No games scheduled</h1>
      <p class="muted">The schedule will fill in once the season data syncs.</p>
    </section>
  )}

  <TeamShowcase />

  {star && (
    <section class="spot-hero">
      <div class="sh-card"><PlayerCard player={star} size="lg" /></div>
      <div class="sh-text">
        <span class="eyebrow">Player spotlight</span>
        <h2 class="sh-name">{displayName(star)}</h2>
        <p class="sh-meta">
          <span class="sh-num num">#{star.number}</span>
          {star.position === "G" ? "Goaltender" : star.position === "D" ? "Defence" : "Forward"}
        </p>
        <p class="muted sh-blurb">
          On the banner for {s!.weAreHome ? "the game against" : "the game at"} {s!.them.short}.
          Every player gets a turn before anyone repeats — {rot.featured.length} of {rot.featured.length + rot.remaining} so far this season.
        </p>
        <a class="sh-link" href={`/players/${star.id}`}>See {displayName(star)}'s page →</a>
      </div>
    </section>
  )}

  <section class="section home-news" aria-labelledby="home-news-title">
    <div class="rule-head"><h2 id="home-news-title">Latest news</h2></div>
    <NewsFeed limit={3} />
    <a class="more" href="/news">All news →</a>
  </section>

  <div class="cols">
    <section class="section">
      <div class="rule-head"><h2>Up next</h2></div>
      {p && (
        <div class="practice card">
          <span class="eyebrow">Next practice</span>
          <p class="practice-when">{shortDate(p.startsAt)} · {time(p.startsAt)}</p>
          <p class="dim">{p.venue.name}{p.notes ? ` — ${p.notes}` : ""}</p>
        </div>
      )}
      <div class="list" style="--flow: var(--s-2)">
        {up.length ? up.map((e: any) => <EventRow event={e} />) : <p class="dim">Nothing else on the calendar yet.</p>}
      </div>
      <a class="more" href="/schedule">Full schedule →</a>
    </section>

    <section class="section">
      <div class="rule-head"><h2>Recent results</h2></div>
      <div class="list" style="--flow: var(--s-2)">
        {recent.length
          ? recent.map((e: any) => <EventRow event={e} />)
          : <EmptyState
              icon={false}
              title="No games played yet"
              note="The season is just getting underway — the first games on the calendar are exhibition. Results will appear here as they are played." />}
      </div>


    </section>
  </div>

  <InstallApp />

  <script>import "../scripts/cardfx";</script>
</Base>

<style>
  .hero {
    position: relative;
    margin-bottom: clamp(2rem, 5vw, 4rem);
    padding: var(--s-7) var(--s-5) var(--s-8);
    border: 1px solid var(--hairline);
    border-radius: var(--r-xl);
    background:
      radial-gradient(120% 80% at 50% 0%, rgb(28 143 232 / .10), transparent 60%),
      linear-gradient(180deg, var(--bg-raised), color-mix(in srgb, var(--bg-sunken) 85%, transparent));
    overflow: hidden;
  }
  /* scratched-ice sheen along the bottom edge */
  .hero::after {
    content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 38%;
    pointer-events: none;
    background: linear-gradient(180deg, transparent, rgb(173 191 215 / .07));
    mask-image: linear-gradient(180deg, transparent, #000 70%);
  }
  .hero-top { text-align: center; margin-bottom: var(--s-5); position: relative; z-index: 1; }
  .hero-title {
    font-size: var(--t-hero);
    background: linear-gradient(180deg, #fff 32%, var(--ice-300) 78%, var(--steel-400));
    -webkit-background-clip: text; background-clip: text; color: transparent;
    filter: drop-shadow(0 4px 28px rgb(28 143 232 / .35));
    margin-top: var(--s-2);
  }

  .hero-info {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: var(--s-4); margin-top: var(--s-6);
    border-top: 1px solid var(--hairline); padding-top: var(--s-5);
    position: relative; z-index: 1;
  }
  .info { display: flex; flex-direction: column; gap: var(--s-2); align-items: center; text-align: center; }
  .info--feature .big {
    font-size: var(--t-xl); line-height: 1;
    color: var(--white); text-shadow: 0 0 30px rgb(28 143 232 / .6);
  }
  .info:nth-child(2) { border-inline: 1px solid var(--hairline); }
  @media (max-width: 620px) {
    .hero-info { grid-template-columns: 1fr; }
    .info:nth-child(2) { border-inline: 0; border-block: 1px solid var(--hairline); padding-block: var(--s-4); }
  }

  .hero-cd { margin-top: var(--s-6); position: relative; z-index: 1; }
  .hero-actions {
    display: flex; align-items: flex-start; justify-content: center;
    gap: var(--s-5); flex-wrap: wrap; margin-top: var(--s-6);
    position: relative; z-index: 1;
  }
  .cta {
    display: block; width: fit-content;
    padding: var(--s-3) var(--s-6);
    font-family: var(--font-ui); font-size: var(--t-sm); font-weight: 700;
    letter-spacing: var(--track-label); text-transform: uppercase; text-decoration: none;
    color: var(--white);
    background: linear-gradient(180deg, var(--volt-500), var(--blue-600));
    border-radius: 999px; box-shadow: var(--glow-volt);
    position: relative; z-index: 1;
    transition: transform .2s var(--ease-out-back), box-shadow .2s var(--ease);
  }
  .cta:hover { transform: translateY(-2px) scale(1.02); box-shadow: 0 0 60px -6px rgb(28 143 232 / .8); }

  .hero--empty { text-align: center; }

  .spot-hero {
    display: grid; grid-template-columns: auto 1fr; align-items: center;
    gap: var(--s-8); margin-top: var(--s-8);
    padding: var(--s-7) var(--s-6);
    border: 1px solid var(--hairline); border-radius: var(--r-xl);
    background:
      radial-gradient(90% 120% at 12% 50%, rgb(28 143 232 / .14), transparent 62%),
      linear-gradient(180deg, var(--bg-raised), var(--bg-sunken));
    overflow: hidden;
  }
  .sh-card { filter: drop-shadow(0 18px 50px rgb(0 0 0 / .65)); }
  .sh-name {
    font-size: clamp(2.6rem, 1.2rem + 5.4vw, 5.5rem); line-height: .88;
    margin-block: var(--s-3) var(--s-4);
    background: linear-gradient(180deg, #fff 28%, var(--ice-300) 82%);
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .sh-last {
    background: linear-gradient(180deg, var(--volt-300) 15%, var(--volt-500) 70%, var(--blue-600));
    -webkit-background-clip: text; background-clip: text; color: transparent;
    filter: drop-shadow(0 0 30px rgb(28 143 232 / .45));
  }
  .sh-meta {
    display: flex; align-items: center; gap: var(--s-3);
    font-family: var(--font-ui); font-weight: 700; letter-spacing: var(--track-label);
    text-transform: uppercase; color: var(--text-dim); font-size: var(--t-sm);
  }
  .sh-num { color: var(--volt-300); font-size: var(--t-md); }
  .sh-blurb { margin-top: var(--s-4); max-width: 46ch; }
  .sh-link {
    display: inline-block; margin-top: var(--s-5);
    font-size: var(--t-sm); font-weight: 700; letter-spacing: .08em;
    text-transform: uppercase; color: var(--accent-text); text-decoration: none;
  }
  @media (max-width: 760px) {
    .spot-hero { grid-template-columns: minmax(0, 1fr); justify-items: center; text-align: center; gap: var(--s-6); }
    .sh-card { max-width: 100%; }
    .sh-card :global(.pcard) { max-width: 100%; }
    .sh-meta { justify-content: center; }
    .sh-blurb { margin-inline: auto; }
  }

  .cols { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-7); align-items: start; }
  @media (max-width: 900px) { .cols { grid-template-columns: 1fr; gap: 0; } }

  .list > * + * { margin-top: var(--flow, var(--s-2)); }
  .practice { padding: var(--s-4); margin-bottom: var(--s-4); }
  .practice-when {
    font-family: var(--font-display); font-weight: 900; font-style: italic;
    font-size: var(--t-lg); text-transform: uppercase; margin-top: var(--s-1);
  }
  .home-news { margin-top: var(--s-5); }
  .more {
    display: inline-block; margin-top: var(--s-4);
    font-size: var(--t-sm); font-weight: 700; letter-spacing: .08em;
    text-transform: uppercase; color: var(--accent-text); text-decoration: none;
  }
  .more:hover { color: var(--volt-300); }
  @media (max-width: 600px) {
    .hero { padding: var(--s-5) var(--s-3) var(--s-6); }
    .hero-actions { gap: var(--s-3); }
    .spot-hero { padding: var(--s-5) var(--s-4); margin-top: var(--s-6); }
    .sh-text { min-width: 0; }
  }
</style>
