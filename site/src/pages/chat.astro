---
import Base from "../layouts/Base.astro";
import "../styles/chat.css";
---
<Base title="Chat" description="Keep in touch with Lightning teammates and families." wide>
  <header class="chat-intro">
    <div><p class="eyebrow">Off the ice. Still a team.</p><h1>Team chat</h1></div>
    <p class="muted">Make a plan, share a cheer, stay in touch.</p>
  </header>
  <p id="chat-loading" role="status">Loading your conversations…</p>
  <p id="chat-login" class="card chat-notice" hidden>Sign in with your team account to join the conversation. <a href="/login?next=/chat">Sign in</a></p>
  <noscript><p>Enable JavaScript to send and receive team messages.</p></noscript>
  <div id="chat-app" class="chat-shell card" hidden>
    <aside class="chat-sidebar" aria-label="Conversations">
      <div class="chat-sidebar-head"><h2>Conversations</h2><p id="chat-identity" class="dim"></p></div>
      <div id="chat-rooms" class="chat-rooms"></div>
      <form id="chat-new" class="chat-new">
        <label for="chat-member">Message a teammate or parent</label>
        <select id="chat-member" required><option value="">Choose a team member</option></select>
        <button type="submit" class="ghost">Start conversation</button>
      </form>
    </aside>
    <section class="chat-thread" aria-labelledby="chat-title">
      <header class="chat-thread-head">
        <div><h2 id="chat-title">Team room</h2><p id="chat-audience" class="dim">Everyone with a team account can join in.</p></div>
        <span id="chat-connection" class="chat-connection" role="status">Connecting…</span>
      </header>
      <div id="chat-scroll" class="chat-scroll" tabindex="0" aria-label="Message history">
        <button id="chat-older" type="button" class="ghost chat-older" hidden>Load earlier messages</button>
        <p id="chat-empty" class="chat-empty" hidden>No messages yet. Say hello to the team!</p>
        <ol id="chat-messages" class="chat-messages" aria-label="Messages"></ol>
      </div>
      <button id="chat-latest" class="ghost chat-latest" type="button" hidden>New messages · Jump to latest</button>
      <p id="chat-announcement" class="visually-hidden" role="status" aria-live="polite"></p>
      <p id="chat-error" class="chat-error" role="alert" hidden></p>
      <form id="chat-compose" class="chat-compose">
        <label for="chat-body">Your message</label>
        <textarea id="chat-body" rows="3" maxlength="2000" required placeholder="Write to the team…" aria-describedby="chat-hint"></textarea>
        <div class="chat-compose-bottom"><p id="chat-hint" class="dim">Keep it kind. Enter to send · Shift + Enter for a new line.</p><button id="chat-send" type="submit" disabled>Send message</button></div>
      </form>
    </section>
  </div>
</Base>
<script>
  import "../scripts/chat";
</script>
