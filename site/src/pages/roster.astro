---
import Base from "../layouts/Base.astro";
import PlayerCard from "../components/PlayerCard.astro";
import { roster } from "../lib/data";

const players = [...roster.players].sort((a: any, b: any) => a.number - b.number);
const groups = [
  { key: "Forwards", match: (p: any) => ["C", "LW", "RW", "F"].includes(p.position) },
  { key: "Defence",  match: (p: any) => p.position === "D" },
  { key: "Goaltenders", match: (p: any) => p.position === "G" },
].map((g) => ({ ...g, items: players.filter(g.match) })).filter((g) => g.items.length);
---
<Base title="Roster" wide>
  <header class="page-head">
    <span class="eyebrow">2026–27 Season</span>
    <h1>The Roster</h1>
    <p class="muted">{players.length} players · {roster.staff.length} staff</p>
  </header>

  {groups.map((g) => (
    <section class="section">
      <div class="rule-head"><h2>{g.key}</h2></div>
      <div class="grid">
        {g.items.map((p: any) => <PlayerCard player={p} href={`/players/${p.id}`} />)}
      </div>
    </section>
  ))}

  <section class="section">
    <div class="rule-head"><h2>Coaching Staff</h2></div>
    <ul class="staff">
      {roster.staff.map((s: any) => (
        <li class="card">
          <span class="staff-role eyebrow">{s.role}</span>
          <span class="staff-name">{s.name}</span>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .page-head { margin-bottom: var(--s-7); }
  .page-head h1 { margin-block: var(--s-2); }
  .grid {
    display: grid; gap: var(--s-5);
    grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
    justify-items: center;
  }
  .staff { list-style: none; padding: 0; display: grid; gap: var(--s-3);
           grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); }
  .staff li { padding: var(--s-4); display: flex; flex-direction: column; gap: var(--s-1); }
  .staff-name { font-family: var(--font-display); font-weight: 900; font-style: italic;
                font-size: var(--t-md); text-transform: uppercase; }
</style>
