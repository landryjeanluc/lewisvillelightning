---
import "../styles/global.css";
import { team, isFixtureData } from "../lib/data";

interface Props { title?: string; description?: string; wide?: boolean }
const {
  title,
  description = `Schedule, roster, stats and news for the ${team.name} — ${team.level} ${team.division} minor hockey.`,
  wide = false,
} = Astro.props;

const pageTitle = title ? `${title} · ${team.name}` : `${team.name}`;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const nav = [
  { href: "/",         label: "Home" },
  { href: "/schedule", label: "Schedule" },
  { href: "/roster",   label: "Roster" },
  { href: "/stats",    label: "Stats" },
  { href: "/plays",    label: "Plays" },
  { href: "/goals",    label: "Goals" },
  { href: "/news",     label: "News" },
  { href: "/chat",     label: "Chat" },
];
const isActive = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="referrer" content="no-referrer" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#040814" />
    <link rel="icon" href="/brand/lightning-crest.png" />
    <!-- Home-screen install. The manifest covers Android and desktop Chrome;
         iOS ignores most of it and reads these apple-* tags instead. -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Lightning" />
    <meta name="application-name" content="Lightning" />
    <link rel="preload" href="/fonts/BarlowCondensed-BlackItalic.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/fonts/BarlowSemiCondensed-SemiBold.ttf" as="font" type="font/ttf" crossorigin />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <a href="#main" class="skip">Skip to content</a>

    <header class:list={["site-head", { "has-goals": Astro.slots.has("header-footer") }]}>
      <div class="wrap--wide head-inner">
        <a href="/" class="brand" aria-label={`${team.name} home`}>
          <img src="/brand/lightning-crest.png" alt="" width="52" height="51" class="crest" />
          <span class="brand-text">
            <span class="brand-name">{team.name}</span>
            <span class="brand-sub">{team.level} {team.division}</span>
          </span>
        </a>

        <button class="menu-toggle ghost" type="button" aria-expanded="false" aria-controls="primary-nav" hidden>Menu <span aria-hidden="true">☰</span></button>
        <nav id="primary-nav" aria-label="Primary">
          <ul class="nav">
            {nav.map((n) => (
              <li>
                <a href={n.href} aria-current={isActive(n.href) ? "page" : undefined}>{n.label}</a>
              </li>
            ))}
            <li><a href="/account" aria-current={isActive("/account") ? "page" : undefined}>Account</a></li>
            <li id="admin-nav-item" hidden>
              <a href="/admin" aria-current={isActive("/admin") ? "page" : undefined}>Admin</a>
            </li>
          </ul>
        </nav>
      </div>
      <slot name="header-footer" />
    </header>

    {isFixtureData && (
      <div class="fixture-banner" role="status">
        <strong>Unverified schedule.</strong> A Spordle sync has not been recorded.
        Confirm event details with the team before making plans.
      </div>
    )}

    <main id="main" class={wide ? "wrap--wide" : "wrap"}>
      <slot />
    </main>

    <footer class="site-foot">
      <div class="wrap--wide foot-inner">
        <img src="/brand/lightning-crest.png" alt="" width="40" height="39" class="crest" />
        {team.slogan && <p class="foot-slogan">{team.slogan}</p>}
        <p class="dim">
          {team.name} · {team.level} {team.division} · Home ice: {team.home_arena}
        </p>
        <p class="dim">
          <a href={team.association_website}>Lewisville Minor Hockey Association</a>
        </p>
      </div>
    </footer>

    <style>
      .skip {
        position: absolute; left: -9999px; top: 0; z-index: 100;
        background: var(--volt-500); color: #fff; padding: var(--s-3) var(--s-4);
        font-weight: 700;
      }
      .skip:focus { left: 0; }

      .site-head {
        position: sticky; top: 0; z-index: 50; padding-top: env(safe-area-inset-top);
        background: color-mix(in srgb, var(--bg) 82%, transparent);
        backdrop-filter: blur(14px) saturate(140%);
        border-bottom: 1px solid var(--hairline);
      }
      /* Let the taller homepage header scroll away to keep the content usable on phones. */
      .site-head.has-goals { position: relative; }
      .head-inner {
        display: flex; align-items: center; justify-content: space-between;
        gap: var(--s-5); padding-block: var(--s-3); flex-wrap: wrap;
      }
      .brand { display: flex; align-items: center; gap: var(--s-3); text-decoration: none; min-width: 0; }
      .brand img { width: 52px; height: auto; }
      .brand-text { display: flex; flex-direction: column; line-height: 1; }
      .brand-name {
        font-family: var(--font-display); font-weight: 900; font-style: italic;
        font-size: 1.5rem; letter-spacing: var(--track-tight); text-transform: uppercase;
      }
      .brand-sub {
        font-size: var(--t-micro); font-weight: 700; letter-spacing: var(--track-label);
        text-transform: uppercase; color: var(--text-dim); margin-top: 3px;
      }

      .menu-toggle { display: none; }
      .nav { display: flex; gap: var(--s-5); list-style: none; padding: 0; }
      .nav a {
        position: relative; display: flex; align-items: center; min-height: 44px; padding-block: var(--s-2);
        font-family: var(--font-ui); font-size: var(--t-sm); font-weight: 700;
        letter-spacing: .1em; text-transform: uppercase; text-decoration: none;
        color: var(--text-muted); transition: color .18s var(--ease);
      }
      .nav a:hover { color: var(--text); }
      .nav a[aria-current="page"] { color: var(--text); }
      .nav a[aria-current="page"]::after {
        content: ""; position: absolute; left: 0; right: 0; bottom: -1px; height: 2px;
        background: var(--volt-500); box-shadow: var(--glow-volt);
      }
      @media (max-width: 900px) {
        .head-inner { gap: var(--s-2); }
        .brand { flex: 1; }
        .brand img { width: 40px; flex: none; }
        .brand-name { font-size: clamp(1.05rem, 3.6vw, 1.5rem); }
        .menu-toggle { display: flex; align-items: center; gap: var(--s-2); padding: var(--s-2) var(--s-3); letter-spacing: .06em; }
        #primary-nav { flex-basis: 100%; max-height: calc(100dvh - 80px - env(safe-area-inset-top)); overflow-y: auto; }
        .site-head[data-menu-ready] #primary-nav { display: none; }
        .site-head[data-menu-ready].is-open #primary-nav { display: block; }
        .site-head.is-open :global([data-home-goals]) { display: none; }
        .nav { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-1) var(--s-3); padding-block: var(--s-2); }
        .nav a { padding-inline: var(--s-3); border-radius: var(--r-md); }
        .nav a[aria-current="page"] { background: var(--surface-2); }
        .nav a[aria-current="page"]::after { left: var(--s-3); right: var(--s-3); }
      }

      .fixture-banner {
        background: rgb(224 86 107 / .1);
        border-bottom: 1px solid rgb(224 86 107 / .3);
        color: var(--ice-200);
        font-size: var(--t-sm);
        padding: var(--s-3) var(--s-4);
        text-align: center;
      }
      .fixture-banner strong { color: var(--loss); }

      main { padding-block: var(--s-7) var(--s-9); }
      @media (max-width: 600px) { main { padding-block: var(--s-5) var(--s-7); } }

      .site-foot {
        border-top: 1px solid var(--hairline);
        background: var(--bg-sunken);
        padding-block: var(--s-7) max(var(--s-7), env(safe-area-inset-bottom));
      }
      .foot-slogan {
        font-family: var(--font-display); font-style: italic; font-weight: 900;
        font-size: var(--t-md); text-transform: uppercase;
        letter-spacing: var(--track-tight); color: var(--ice-200);
      }
      .foot-inner {
        display: flex; flex-direction: column; align-items: center; gap: var(--s-2);
        text-align: center; font-size: var(--t-sm);
      }
    </style>
    <script>
      const head = document.querySelector<HTMLElement>(".site-head")!;
      const toggle = head.querySelector<HTMLButtonElement>(".menu-toggle")!;
      const mobile = matchMedia("(max-width: 900px)");
      const adminNav = head.querySelector<HTMLElement>("#admin-nav-item")!;
      let authRequest = 0;
      async function refreshAdminLink() {
        const request = ++authRequest;
        adminNav.hidden = true;
        try {
          const response = await fetch("/api/auth/me", { credentials: "same-origin", cache: "no-store" });
          const user = response.ok ? await response.json() : null;
          if (request === authRequest) adminNav.hidden = user?.role !== "admin";
        } catch { /* Keep the link hidden when the session cannot be checked. */ }
      }
      document.addEventListener("auth:changed", refreshAdminLink);
      window.addEventListener("pageshow", refreshAdminLink);
      const setOpen = (open: boolean) => {
        head.classList.toggle("is-open", open);
        toggle.setAttribute("aria-expanded", String(open));
      };
      head.dataset.menuReady = "";
      toggle.hidden = false;
      toggle.addEventListener("click", () => setOpen(toggle.getAttribute("aria-expanded") !== "true"));
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && head.classList.contains("is-open")) {
          setOpen(false); toggle.focus();
        }
      });
      document.addEventListener("click", (event) => {
        if (!head.contains(event.target as Node)) setOpen(false);
      });
      mobile.addEventListener("change", () => setOpen(false));
    </script>
  </body>
</html>

<script>
  // A restored back/forward-cache snapshot must recheck the server's login gate.
  window.addEventListener("pagehide", () => { document.documentElement.style.visibility = "hidden"; });
  window.addEventListener("pageshow", event => {
    if (event.persisted) location.reload();
    else document.documentElement.style.visibility = "";
  });
</script>
