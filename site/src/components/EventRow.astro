---
import { sides, outcome, crestUrl, US } from "../lib/data";
import { monthAbbr, dayNum, weekdayAbbr, time, relativeDay, machine } from "../lib/format";

interface Props { event: any }
const { event } = Astro.props;
const isGame = event.type === "game";
const s = isGame ? sides(event) : null;
const o = isGame ? outcome(event) : null;
const href = `/schedule/${event.id}`;
---
<a class="row card card--link" href={href}>
  <time class="chip" datetime={machine(event.startsAt)}>
    <span class="chip-wd">{weekdayAbbr(event.startsAt)}</span>
    <span class="chip-day num">{dayNum(event.startsAt)}</span>
    <span class="chip-mo">{monthAbbr(event.startsAt)}</span>
  </time>

  <div class="body">
    <div class="line1">
      {isGame ? (
        <>
          <img class="mini" src={crestUrl(s!.them)} alt="" width="34" height="34" />
          <span class="opp">
            <span class="va">{s!.weAreHome ? "vs" : "at"}</span> {s!.them.short}
          </span>
        </>
      ) : (
        <span class="opp"><span class="va">Practice</span></span>
      )}
      {isGame && event.gameType && event.gameType !== "regular" && (
        <span class="pill pill--type">{event.gameType}</span>
      )}
      {event.status === "cancelled"  && <span class="pill pill--loss">Cancelled</span>}
      {event.status === "postponed"  && <span class="pill">Postponed</span>}
      {event.status === "in_progress"&& <span class="pill pill--live">Live</span>}
      {o && <span class:list={["pill", o.result === "W" ? "pill--win" : o.result === "L" ? "pill--loss" : ""]}>{o.label}</span>}
    </div>
    <div class="line2 dim">
      {time(event.startsAt)} · {event.venue.name}
      {isGame && s!.weAreHome && <span class="pill pill--home">Home</span>}
    </div>
  </div>

  <span class="when dim">{relativeDay(event.startsAt)}</span>
</a>

<style>
  .row {
    display: grid; grid-template-columns: auto 1fr auto;
    align-items: center; gap: var(--s-4);
    padding: var(--s-3) var(--s-4);
    text-decoration: none;
  }
  .chip {
    display: grid; place-items: center; line-height: 1;
    width: 58px; padding: var(--s-2) 0;
    border-radius: var(--r-md);
    background: var(--surface-2);
    border: 1px solid var(--hairline);
  }
  .chip-wd, .chip-mo {
    font-size: var(--t-micro); font-weight: 700; letter-spacing: .12em;
    text-transform: uppercase; color: var(--text-dim);
  }
  .chip-day { font-size: 1.5rem; color: var(--text); }
  .mini { width: 34px; height: auto; flex: none; }
  .body { min-width: 0; }
  .line1 { display: flex; align-items: center; gap: var(--s-3); flex-wrap: wrap; }
  .opp {
    font-family: var(--font-display); font-weight: 900; font-style: italic;
    font-size: var(--t-md); text-transform: uppercase; letter-spacing: var(--track-tight);
  }
  .va { color: var(--text-dim); font-style: normal; font-weight: 700; font-size: .8em; }
  .line2 { display: flex; align-items: center; gap: var(--s-3); font-size: var(--t-sm); margin-top: 2px; }
  .when { font-size: var(--t-sm); white-space: nowrap; }
  .pill--type { color: var(--ice-200); border-color: var(--hairline-sv); }
  @media (max-width: 560px) {
    .row { grid-template-columns: auto 1fr; }
    .when { display: none; }
  }
</style>
