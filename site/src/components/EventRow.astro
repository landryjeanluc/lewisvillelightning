---
import TeamCrest from "./TeamCrest.astro";
import { sides, outcome, US } from "../lib/data";
import { monthAbbr, dayNum, weekdayAbbr, time, relativeDay, machine } from "../lib/format";

interface Props { event: any }
const { event } = Astro.props;
const isGame = event.type === "game";
// Away on the left, home on the right — the scoreboard convention, and the
// same one the matchup band and the posters use. Showing only the opponent
// told you nothing about which rink you were driving to.
const s = isGame ? sides(event) : null;
const o = isGame ? outcome(event) : null;
const href = `/schedule/${event.id}`;
---
<a class="row card card--link" href={href}>
  <time class="chip" datetime={machine(event.startsAt)}>
    <span class="chip-wd">{weekdayAbbr(event.startsAt)}</span>
    <span class="chip-day num">{dayNum(event.startsAt)}</span>
    <span class="chip-mo">{monthAbbr(event.startsAt)}</span>
  </time>

  <div class="body">
    {isGame ? (
      <div class="teams">
        <span class:list={["team", s!.left.id === US && "team--us"]}>
          <TeamCrest team={s!.left} size={30} />
          <span class="tname">{s!.left.short}</span>
        </span>
        <span class="at" aria-hidden="true">{s!.weAreHome ? "vs" : "@"}</span>
        <span class:list={["team", "team--r", s!.right.id === US && "team--us"]}>
          <span class="tname">{s!.right.short}</span>
          <TeamCrest team={s!.right} size={30} />
        </span>
        {o && (
          <span class:list={["pill", o.result === "W" ? "pill--win" : o.result === "L" ? "pill--loss" : ""]}>
            {o.label}
          </span>
        )}
      </div>
    ) : (
      <div class="teams"><span class="tname tname--solo">Practice</span></div>
    )}

    <div class="line2 dim">
      <span class="ha">{isGame ? (s!.weAreHome ? "Home" : "Away") : "Ice time"}</span>
      <span>{time(event.startsAt)}</span>
      <span class="venue">{event.venue.name}</span>
      {isGame && event.gameType && event.gameType !== "regular" && (
        <span class="pill pill--type">{event.gameType}</span>
      )}
      {event.status === "cancelled" && <span class="pill pill--loss">Cancelled</span>}
      {event.status === "postponed" && <span class="pill">Postponed</span>}
      {event.status === "in_progress" && <span class="pill pill--live">Live</span>}
    </div>
  </div>

  <span class="when dim">{relativeDay(event.startsAt)}</span>
</a>

<style>
  .row {
    display: grid; grid-template-columns: auto 1fr auto;
    align-items: center; gap: var(--s-4);
    padding: var(--s-3) var(--s-4);
    text-decoration: none;
  }
  .chip {
    display: grid; place-items: center; line-height: 1;
    width: 58px; padding: var(--s-2) 0;
    border-radius: var(--r-md);
    background: var(--surface-2);
    border: 1px solid var(--hairline);
  }
  .chip-wd, .chip-mo {
    font-size: var(--t-micro); font-weight: 700; letter-spacing: .12em;
    text-transform: uppercase; color: var(--text-dim);
  }
  .chip-day { font-size: 1.5rem; color: var(--text); }

  .body { min-width: 0; }
  .teams { display: flex; align-items: center; gap: var(--s-3); flex-wrap: wrap; }
  .team { display: inline-flex; align-items: center; gap: var(--s-2); }
  .row :global(.team .tc) { --crest-size: 30px; }
  .tname {
    font-family: var(--font-display); font-weight: 900; font-style: italic;
    font-size: var(--t-md); text-transform: uppercase; letter-spacing: var(--track-tight);
    color: var(--text-muted);
  }
  /* our own name reads solid so the row is scannable at a glance */
  .team--us .tname { color: var(--white); }
  .tname--solo { color: var(--white); }
  .at {
    font-family: var(--font-ui); font-size: var(--t-xs); font-weight: 700;
    letter-spacing: .14em; text-transform: uppercase; color: var(--text-dim);
  }

  .line2 {
    display: flex; align-items: center; gap: var(--s-3);
    font-size: var(--t-sm); margin-top: var(--s-2); flex-wrap: wrap;
  }
  .ha {
    font-weight: 700; letter-spacing: .1em; text-transform: uppercase;
    font-size: var(--t-micro); color: var(--accent-text);
  }
  .venue { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .pill--type { color: var(--ice-200); border-color: var(--hairline-sv); }
  .when { font-size: var(--t-sm); white-space: nowrap; }

  @media (max-width: 640px) {
    .row { grid-template-columns: auto 1fr; }
    .when { display: none; }
    .venue { max-width: 14rem; }
  }
</style>
