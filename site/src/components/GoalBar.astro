<article class="goal-bar" data-goal-bar="hockey" style="--progress: 0%">
  <div class="gb-heading">
    <div class="gb-identity">
      <svg class="gb-emblem" aria-hidden="true" viewBox="0 0 48 48" width="28" height="28"><path d="m12 7 17 28 10 1-1 6-13-2L7 10m29-3L19 35 -10 1 1 6 13-2L41 10" fill="none" stroke="currentColor" stroke-width="3" stroke-linejoin="round" /><ellipse cx="24" cy="31" rx="6" ry="3" fill="currentColor" /></svg>
      <h2 data-goal-title>Loading team goal…</h2>
    </div>
    <span class="gb-label">Team goal</span>
  </div>

  <div class="gb-track" role="progressbar" aria-label="Team goal progress" aria-valuemin="0" aria-valuemax="100" aria-valuetext="Loading team goal" data-goal-progress>
    <div class="rink" aria-hidden="true">
      <div class="rink-fill"></div>
      <span class="rink-line rink-line--blue rink-line--left"></span>
      <span class="rink-line rink-line--red"></span>
      <span class="rink-line rink-line--blue rink-line--right"></span>
      <span class="rink-circle rink-circle--centre"></span>
      <span class="rink-circle rink-circle--left"></span>
      <span class="rink-circle rink-circle--right"></span>
      <span class="rink-net"></span>
      <div class="rink-path"><span class="rink-puck"><span></span></span></div>
    </div>
    <div class="gb-meter" aria-hidden="true">
      <p><strong data-goal-total>—</strong><span data-goal-target> / —</span></p>
      <span class="gb-percent"><strong data-goal-percent>—</strong>%</span>
    </div>
  </div>

  <div class="visually-hidden">
    <span data-goal-status>Getting ready</span>
    <p data-goal-remaining>Every rep moves the puck.</p>
    <span data-goal-deadline></span>
  </div>
</article>

<style>
  .goal-bar {
    --progress: 0%; --bar-accent: #79d8ef;
    position: relative; min-width: 0;
  }
  .gb-heading { display: flex; align-items: center; justify-content: space-between; gap: .75rem; min-height: 36px; }
  .gb-identity { display: flex; align-items: center; gap: .5rem; min-width: 0; }
  .gb-emblem { flex: none; color: var(--bar-accent); }
  .gb-label { flex: none; color: var(--bar-accent); font-size: .65rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; white-space: nowrap; }
  h2 { min-width: 0; font-size: clamp(1.1rem, 2.4vw, 1.5rem); line-height: 1.1; font-style: italic; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .gb-track { position: relative; height: 68px; }
  .gb-meter { position: absolute; top: 7px; left: 50%; transform: translateX(-50%); display: flex; align-items: center; gap: .65rem; max-width: calc(100% - 38px); padding: .15rem .7rem; border: 1px solid #79d8ef55; border-radius: 20px; background: #0a2032; box-shadow: 0 2px 5px #09253830; color: #e7f4f7; }
  .gb-meter p { min-width: 0; font-size: .8rem; line-height: 1.2; }
  .gb-meter p strong { color: #fff; font-variant-numeric: tabular-nums; }
  .gb-percent { flex: none; padding-left: .65rem; border-left: 1px solid #79d8ef55; color: var(--bar-accent); font-size: .7rem; white-space: nowrap; }
  .gb-percent strong { font: italic 900 1.3rem/1 var(--font-display); font-variant-numeric: tabular-nums; }

  /* A puck travelling across real rink markings, right into the red net. */
  .rink { position: absolute; inset: 0; border: 3px solid #b8d2df; border-bottom: 5px solid #e2b956; border-radius: 40px; overflow: hidden; background: repeating-linear-gradient(168deg, #ffffff00 0 8px, #9bbac018 9px, #ffffff00 10px 16px), #e7f4f7; box-shadow: 0 4px 14px #0004, inset 0 2px 5px #708c9f44; }
  .rink-fill { position: absolute; inset: 0 auto 0 0; width: var(--progress); background: linear-gradient(90deg, #268db344, #23bbd291); transition: width 1s var(--ease); }
  .rink-line { position: absolute; top: 0; bottom: 0; width: 3px; }
  .rink-line--blue { background: #1475bb94; }
  .rink-line--left { left: 29%; }
  .rink-line--right { left: 71%; }
  .rink-line--red { left: 50%; background: repeating-linear-gradient(#c7405280 0 5px, #e7f4f7 5px 8px); }
  .rink-circle { position: absolute; width: 42px; height: 42px; top: 50%; border: 1px solid #bc425b5e; border-radius: 50%; transform: translate(-50%, -50%); }
  .rink-circle--centre { left: 50%; border-color: #1475bb66; }
  .rink-circle--left { left: 16%; }
  .rink-circle--right { left: 84%; }
  .rink-net { position: absolute; right: 12px; top: 50%; transform: translateY(-50%); width: 25px; height: 43px; border: 2px solid #ba3d4b; border-left-width: 4px; border-radius: 2px 9px 9px 2px; background: repeating-linear-gradient(0deg, transparent 0 4px, #678ca65e 4px 5px), repeating-linear-gradient(90deg, transparent 0 4px, #678ca65e 4px 5px), #fff9; }
  .rink-path { position: absolute; left: 22px; right: 28px; top: 76%; }
  .rink-puck { position: absolute; left: var(--progress); width: 32px; height: 21px; transform: translate(-50%, -40%); border-radius: 50%; background: linear-gradient(#303d4a, #030a12); box-shadow: 0 4px 4px #0d283c66, -7px 1px 12px #61cfed; transition: left 1s var(--ease); }
  .rink-puck > span { position: absolute; inset: 0 0 5px; border-radius: 50%; background: #1b2d3a; border: 1px solid #5c6e7c; }

  .is-complete .gb-status { color: #baff9a; }
  .is-complete .rink { border-bottom-color: #7cdb92; }
  @media (max-width: 400px) {
    .gb-heading { gap: .5rem; }
    .gb-emblem { width: 24px; height: 24px; }
    .gb-meter { width: max-content; }
  }
</style>
