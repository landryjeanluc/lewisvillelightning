---
interface Props { theme: "hockey" | "lightning" }
const { theme } = Astro.props;
const hockey = theme === "hockey";
---
<article class:list={["goal-bar", `goal-bar--${theme}`]} data-goal-bar={theme} style="--progress: 0%">
  <div class="gb-heading">
    <div class="gb-identity">
      <span class="gb-emblem" aria-hidden="true">
        {hockey ? (
          <svg viewBox="0 0 48 48" width="40" height="40"><path d="m12 7 17 28 10 1-1 6-13-2L7 10m29-3L19 35  -10 1 1 6 13-2L41 10" fill="none" stroke="currentColor" stroke-width="3" stroke-linejoin="round" /><ellipse cx="24" cy="31" rx="6" ry="3" fill="currentColor" /></svg>
        ) : (
          <svg viewBox="0 0 48 48" width="40" height="40"><path d="M27 3 9 27h13l-3 18 21-27H26z" fill="currentColor" /></svg>
        )}
      </span>
      <div class="gb-title-wrap">
        <p class="gb-kicker">{hockey ? "01 / Hockey · Chase the goal" : "02 / Lightning · Power the team"}</p>
        <h2 data-goal-title>Loading team goal…</h2>
      </div>
    </div>
    <div class="gb-percent" aria-hidden="true"><strong data-goal-percent>—</strong><span>%</span></div>
  </div>

  <div class="gb-scoreline">
    <p><strong data-goal-total>—</strong><span data-goal-target> / —</span></p>
    <span class="gb-status" data-goal-status>Getting ready</span>
  </div>

  <div class="gb-track" role="progressbar" aria-label={`${hockey ? "Hockey" : "Lightning"} team goal progress`} aria-valuemin="0" aria-valuemax="100" aria-valuetext="Loading team goal" data-goal-progress>
    {hockey ? (
      <div class="rink" aria-hidden="true">
        <div class="rink-fill"></div>
        <span class="rink-line rink-line--blue rink-line--left"></span>
        <span class="rink-line rink-line--red"></span>
        <span class="rink-line rink-line--blue rink-line--right"></span>
        <span class="rink-circle rink-circle--centre"></span>
        <span class="rink-circle rink-circle--left"></span>
        <span class="rink-circle rink-circle--right"></span>
        <span class="rink-net"></span>
        <div class="rink-path"><span class="rink-puck"><span></span></span></div>
      </div>
    ) : (
      <div class="charge" aria-hidden="true">
        <div class="charge-fill"></div>
        <div class="charge-segments"></div>
        <svg class="charge-current" viewBox="0 0 600 48" preserveAspectRatio="none"><path d="m0 25 60-4 18 8 30-13 17 22 30-28 18 17 43-8 32 10 27-5 19-16 18 30 22-18 39 9 28-7 34 4 20-13 25 17 35-6 20 5 21-2" /></svg>
        <div class="charge-path"><span class="charge-bolt"><svg viewBox="0 0 30 44"><path d="M19 1 2 25h12L10 43l19-27H17z" /></svg></span></div>
        <span class="charge-cap"></span>
      </div>
    )}
  </div>

  <div class="gb-footer">
    <p data-goal-remaining>{hockey ? "Every rep moves the puck." : "Every player adds to the charge."}</p>
    <span data-goal-deadline></span>
  </div>
</article>

<style>
  .goal-bar {
    --progress: 0%; --bar-accent: #79d8ef;
    position: relative; min-width: 0; padding: clamp(1rem, 2.2vw, 1.5rem);
    border: 1px solid #487b995c; border-radius: 18px; overflow: hidden;
    background: linear-gradient(135deg, #152d42, #091526 80%);
    box-shadow: 0 12px 28px #0003, inset 0 1px #ffffff12;
  }
  .gb-heading { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .gb-identity { display: flex; align-items: center; gap: .8rem; min-width: 0; }
  .gb-emblem { display: grid; place-items: center; width: 52px; height: 52px; flex: none; color: var(--bar-accent); background: #83dfff0a; border: 1px solid #8ddcf52b; border-radius: 12px; }
  .gb-title-wrap { min-width: 0; }
  .gb-kicker { font-size: .66rem; font-weight: 700; letter-spacing: .13em; text-transform: uppercase; color: var(--bar-accent); margin-bottom: .4rem; }
  h2 { font-size: clamp(1.45rem, 2.4vw, 2rem); line-height: 1; font-style: italic; }
  .gb-percent { display: flex; align-items: baseline; flex: none; gap: 2px; color: var(--bar-accent); }
  .gb-percent strong { font: italic 900 clamp(2.2rem, 4vw, 3.2rem)/1 var(--font-display); font-variant-numeric: tabular-nums; }
  .gb-percent > span { font-size: .9rem; font-weight: 700; }
  .gb-scoreline { display: flex; align-items: baseline; justify-content: space-between; gap: .5rem 1rem; flex-wrap: wrap; margin-block: 1rem .6rem; }
  .gb-scoreline p { color: #a9bdd1; font-size: .9rem; }
  .gb-scoreline strong { font-size: 1.2rem; color: #fff; font-variant-numeric: tabular-nums; }
  .gb-status { font-size: .65rem; font-weight: 700; text-transform: uppercase; letter-spacing: .12em; color: var(--bar-accent); }
  .gb-track { position: relative; height: 54px; }
  .gb-footer { display: flex; justify-content: space-between; gap: .25rem 1rem; flex-wrap: wrap; margin-top: .65rem; font-size: .8rem; color: #a9bdd1; }
  .gb-footer p { color: #d7e8f3; }
  .gb-footer > span { white-space: nowrap; }

  /* A puck travelling across real rink markings, right into the red net. */
  .rink { position: absolute; inset: 0; border: 3px solid #b8d2df; border-bottom: 5px solid #e2b956; border-radius: 28px; overflow: hidden; background: repeating-linear-gradient(168deg, #ffffff00 0 8px, #9bbac018 9px, #ffffff00 10px 16px), #e7f4f7; box-shadow: 0 4px 14px #0004, inset 0 2px 5px #708c9f44; }
  .rink-fill { position: absolute; inset: 0 auto 0 0; width: var(--progress); background: linear-gradient(90deg, #268db344, #23bbd291); transition: width 1s var(--ease); }
  .rink-line { position: absolute; top: 0; bottom: 0; width: 3px; }
  .rink-line--blue { background: #1475bb94; }
  .rink-line--left { left: 29%; }
  .rink-line--right { left: 71%; }
  .rink-line--red { left: 50%; background: repeating-linear-gradient(#c7405280 0 5px, #e7f4f7 5px 8px); }
  .rink-circle { position: absolute; width: 30px; height: 30px; top: 50%; border: 1px solid #bc425b5e; border-radius: 50%; transform: translate(-50%, -50%); }
  .rink-circle--centre { left: 50%; border-color: #1475bb66; }
  .rink-circle--left { left: 16%; }
  .rink-circle--right { left: 84%; }
  .rink-net { position: absolute; right: 12px; top: 50%; transform: translateY(-50%); width: 21px; height: 29px; border: 2px solid #ba3d4b; border-left-width: 4px; border-radius: 2px 9px 9px 2px; background: repeating-linear-gradient(0deg, transparent 0 4px, #678ca65e 4px 5px), repeating-linear-gradient(90deg, transparent 0 4px, #678ca65e 4px 5px), #fff9; }
  .rink-path { position: absolute; left: 18px; right: 25px; top: 50%; }
  .rink-puck { position: absolute; left: var(--progress); width: 25px; height: 16px; transform: translate(-50%, -40%); border-radius: 50%; background: linear-gradient(#303d4a, #030a12); box-shadow: 0 4px 4px #0d283c66, -7px 1px 12px #61cfed; transition: left 1s var(--ease); }
  .rink-puck > span { position: absolute; inset: 0 0 5px; border-radius: 50%; background: #1b2d3a; border: 1px solid #5c6e7c; }

  /* A segmented power cell with a current that ends at the moving bolt. */
  .goal-bar--lightning { --bar-accent: #baff6a; border-color: #77bcfa5c; background: radial-gradient(ellipse at 90% 0%, #1957b755, transparent 65%), linear-gradient(125deg, #101f43, #071022 80%); }
  .goal-bar--lightning::before { content: ""; position: absolute; width: 140px; height: 240px; top: -50px; right: 25px; background: #429af90a; clip-path: polygon(54% 0, 7% 57%, 44% 57%, 25% 100%, 96% 36%, 59% 36%, 79% 0); pointer-events: none; }
  .goal-bar--lightning .gb-emblem { color: #baff6a; border-color: #baff6a35; background: #baff6a09; }
  .charge { position: absolute; inset: 5px 0; border: 1px solid #4b9cf377; border-radius: 7px; background: #030b1b; box-shadow: inset 0 0 16px #020714, 0 0 20px #157be41c; }
  .charge-fill { position: absolute; inset: 0 auto 0 0; width: var(--progress); border-radius: 6px; background: linear-gradient(90deg, #1754a8, #21bdd2 65%, #aaff68); box-shadow: 0 0 15px #5edfea70; transition: width 1s var(--ease); }
  .charge-segments { position: absolute; inset: 0; border-radius: inherit; background: repeating-linear-gradient(90deg, transparent 0 calc(10% - 2px), #071226ab calc(10% - 2px) 10%); }
  .charge-current { position: absolute; inset: 0; width: 100%; height: 100%; clip-path: inset(0 calc(100% - var(--progress)) 0 0); transition: clip-path 1s var(--ease); opacity: .7; }
  .charge-current path { fill: none; stroke: #d9ffff; stroke-width: 1.5; filter: drop-shadow(0 0 3px #d5ffbd); }
  .charge-path { position: absolute; inset: 0 15px; }
  .charge-bolt { position: absolute; top: 50%; left: var(--progress); width: 25px; height: 40px; transform: translate(-50%, -50%); transition: left 1s var(--ease); filter: drop-shadow(0 0 7px #cbff82); }
  .charge-bolt svg { width: 100%; height: 100%; fill: #efffc4; stroke: #608b15; stroke-width: .7; }
  .charge-cap { position: absolute; right: -1px; top: 25%; bottom: 25%; width: 3px; background: #baff6a; box-shadow: 0 0 10px #baff6a90; border-radius: 2px; }
  .is-complete .gb-status { color: #baff9a; }
  .is-complete .rink { border-bottom-color: #7cdb92; }
  @media (max-width: 400px) {
    .gb-emblem { width: 38px; height: 42px; border-radius: 8px; }
    .gb-emblem svg { width: 30px; height: 30px; }
    .gb-identity { gap: .6rem; }
    .gb-heading { gap: .5rem; }
    .gb-kicker { font-size: .6rem; letter-spacing: .08em; }
    .gb-percent strong { font-size: 2.1rem; }
    h2 { font-size: 1.4rem; }
  }
</style>
