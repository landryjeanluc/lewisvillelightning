---
import GoalBar from "./GoalBar.astro";
---
<section class="home-goals" aria-label="Team goal" data-home-goals>
  <div class="wrap--wide hg-inner">
    <label class="hg-select" hidden data-goals-picker>Team challenge <select aria-label="Choose a team goal" data-goals-select></select></label>
    <GoalBar />
    <div class="hg-actions">
      <div class="hg-notice">
        <p class="dim" data-goals-notice role="status"></p>
        <button class="link" type="button" data-goals-retry hidden>Try again</button>
        <button class="link" type="button" data-goals-preview hidden aria-pressed="false">Preview progress</button>
      </div>
    </div>
    <noscript><p class="dim">Enable JavaScript to load your team's progress, or <a href="/goals">visit Goals</a>.</p></noscript>
  </div>
</section>
<script>import "../scripts/home-goals";</script>
<style>
  .home-goals { border-top: 1px solid #79d8ef24; background: linear-gradient(110deg, #142d40, #091526 80%); box-shadow: inset 0 -1px #79d8ef18; }
  .hg-inner { padding-top: .25rem; padding-bottom: .65rem; }
  .hg-actions { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0 1rem; }
  .hg-select { max-width: 32rem; margin-bottom: .75rem; }
  .hg-select select { width: 100%; text-transform: none; letter-spacing: normal; }
  .hg-notice { display: flex; align-items: center; flex-wrap: wrap; gap: 0 1rem; font-size: .75rem; }
  .hg-notice p:empty { display: none; }
  .hg-notice button { font-size: .8rem; min-height: 44px; }
</style>
