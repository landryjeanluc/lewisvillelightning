---
import { displayName, showPhotos, type Player } from "../lib/data";

interface Props { player: Player; href?: string; size?: "sm" | "md" | "lg" }
const { player: p, href, size = "md" } = Astro.props;

const POS: Record<string, string> = {
  C: "Centre", LW: "Left Wing", RW: "Right Wing", F: "Forward", D: "Defence", G: "Goaltender",
};
const toPublic = (s: string) => encodeURI("/" + s.replace(/^assets\//, ""));
const photo = showPhotos() && p.photo ? toPublic(p.photo) : null;
// Real card art is a finished card — crest, name, number, position are already
// on it. When present it IS the card; the generated chrome would only repeat
// what the artwork says.
const art = showPhotos() && p.cardArt ? toPublic(p.cardArt) : null;
const artWebp = art ? art.replace(/\.(jpe?g|png)$/i, ".webp") : null;
const Tag = href ? "a" : "div";
---
<Tag data-player-card={p.id} data-base-position={p.position} data-base-shoots={p.shoots ?? ""} data-allow-photo={showPhotos() ? "true" : "false"} class:list={["pcard", `pcard--${size}`, art && "pcard--art", !art && p.position === "G" && "pcard--goalie"]} href={href}>
  <div class="holo" aria-hidden="true"></div>
  <div class="glare" aria-hidden="true"></div>
  <div class="foil" aria-hidden="true"></div>

  <header class="pc-head">
    <span class="pc-team">Lightning</span>
    <span class="pc-pos">{p.position}</span>
  </header>

  <div class="pc-art">
    {!art && <img class="pc-watermark" src="/brand/lightning-crest.png" alt="" aria-hidden="true" />}
    {art
      ? <picture>
          <source type="image/webp" srcset={artWebp} />
          <img class="pc-photo" src={art} alt={`${displayName(p)} player card`} loading="lazy" decoding="async" />
        </picture>
      : photo
        ? <img class="pc-photo" src={photo} alt="" loading="lazy" />
        : <span class="pc-number num" aria-hidden="true">{p.number}</span>}
    {p.captain && <span class="pc-captain" title={p.captain === "C" ? "Captain" : "Alternate captain"}>{p.captain}</span>}
  </div>

  <footer class="pc-plate">
    <span class="pc-num-sm num">#{p.number}</span>
    <span class="pc-name">{displayName(p)}</span>
    <span class="pc-role">{POS[p.position] ?? p.position}{p.shoots ? ` · Shoots ${p.shoots}` : ""}</span>
  </footer>
</Tag>

<style>
  .pcard {
    --cw: 230px;
    /* pointer position, 0-100, written by cardfx.ts */
    --mx: 50; --my: 50;
    --rx: 0deg; --ry: 0deg;
    transform-style: preserve-3d;
    position: relative;
    display: flex; flex-direction: column;
    width: var(--cw); max-width: 100%; aspect-ratio: 2.5 / 3.5;
    padding: 3px;
    border-radius: var(--r-lg);
    text-decoration: none; color: inherit;
    isolation: isolate; overflow: hidden;
    background:
      linear-gradient(160deg, var(--blue-400) 0%, var(--navy-800) 26%, var(--navy-950) 60%, var(--navy-700) 100%);
    box-shadow: var(--shadow-md);
    transition: transform .4s var(--ease-out-back), box-shadow .4s var(--ease);
  }
  /* 3D tilt driven by the pointer, or by the phone's gyroscope */
  .pcard.is-tilting {
    transition: transform .08s linear, box-shadow .3s var(--ease);
    transform: perspective(900px) rotateX(var(--rx)) rotateY(var(--ry)) scale(1.05);
    box-shadow: var(--shadow-lg), 0 0 60px -12px rgb(28 143 232 / .75);
  }

  /* The trading-card holo: a rainbow sheen that slides as the card turns.
     color-dodge is what makes it read as foil rather than a coloured overlay. */
  .holo {
    position: absolute; inset: 0; z-index: 4; pointer-events: none;
    border-radius: inherit; opacity: 0;
    /* A narrow travelling band, not a wash: real foil catches the light in a
       stripe and the artwork has to stay readable through it. */
    background:
      linear-gradient(112deg,
        transparent 41%,
        rgb(255 90 200 / .20) 46%,
        rgb(120 220 255 / .30) 49.5%,
        rgb(150 255 180 / .26) 52%,
        rgb(255 230 130 / .22) 55%,
        transparent 60%);
    background-size: 280% 280%;
    background-position: calc(var(--mx) * 1%) calc(var(--my) * 1%);
    mix-blend-mode: color-dodge;
    transition: opacity .35s var(--ease);
  }
  .pcard.is-tilting .holo { opacity: .85; }

  /* a soft specular highlight that tracks the pointer */
  .glare {
    position: absolute; inset: 0; z-index: 5; pointer-events: none;
    border-radius: inherit; opacity: 0;
    background: radial-gradient(26% 26% at calc(var(--mx) * 1%) calc(var(--my) * 1%),
      rgb(255 255 255 / .38), transparent 72%);
    mix-blend-mode: overlay;
    transition: opacity .35s var(--ease);
  }
  .pcard.is-tilting .glare { opacity: .9; }

  /* lift the contents off the surface so the tilt has depth */
  .pcard.is-tilting .pc-number { transform: translateZ(38px); }
  .pcard.is-tilting .pc-plate  { transform: translateZ(22px); }
  .pcard.is-tilting .pc-head   { transform: translateZ(18px); }
  .pc-number, .pc-plate, .pc-head { transition: transform .25s var(--ease); }

  @media (prefers-reduced-motion: reduce) {
    .pcard.is-tilting { transform: none; }
    .pcard.is-tilting .holo, .pcard.is-tilting .glare { opacity: 0; }
    .pcard.is-tilting .pc-number,
    .pcard.is-tilting .pc-plate,
    .pcard.is-tilting .pc-head { transform: none; }
  }
  .pcard--sm { --cw: 170px; }
  .pcard--lg { --cw: 320px; }
  a.pcard:hover { transform: translateY(-6px) rotate(-.6deg); box-shadow: var(--shadow-lg), var(--glow-volt); }

  /* metallic edge sweep */
  .foil {
    position: absolute; inset: 0; z-index: 3; pointer-events: none;
    border-radius: inherit;
    padding: 1px;
    background: linear-gradient(145deg,
      rgb(255 255 255 / .75), rgb(111 192 255 / .35) 22%,
      transparent 46%, transparent 62%, rgb(255 255 255 / .35));
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor; mask-composite: exclude;
  }

  .pc-head, .pc-plate, .pc-art { position: relative; z-index: 2; }

  .pc-head {
    display: flex; align-items: center; justify-content: space-between;
    padding: var(--s-2) var(--s-3) var(--s-1);
  }
  .pc-team {
    font-family: var(--font-display); font-style: italic; font-weight: 900;
    font-size: .8rem; letter-spacing: .02em; text-transform: uppercase;
    color: var(--ice-200);
  }
  .pc-pos {
    font-family: var(--font-ui); font-size: var(--t-micro); font-weight: 700;
    letter-spacing: .14em; color: var(--navy-950);
    background: linear-gradient(180deg, var(--ice-100), var(--ice-300));
    padding: 2px 7px; border-radius: 3px;
  }

  /* A dark inner panel so the number reads as lit metal against depth,
     rather than sitting flat on the card's own gradient. */
  .pc-art {
    position: relative;
    flex: 1; display: grid; place-items: center;
    margin: 0 var(--s-2);
    border-radius: var(--r-md);
    border: 1px solid rgb(255 255 255 / .07);
    background:
      radial-gradient(68% 58% at 50% 32%, rgb(28 143 232 / .34), transparent 72%),
      linear-gradient(168deg, #0D1B3E 0%, #060C1F 52%, #0A1430 100%);
    box-shadow: inset 0 0 36px rgb(0 0 0 / .75);
    overflow: hidden;
  }
  /* electric streak raking across the panel */
  .pc-art::before {
    content: ""; position: absolute; inset: -20%;
    background: linear-gradient(104deg,
      transparent 38%, rgb(111 192 255 / .20) 47%, rgb(255 255 255 / .34) 50%,
      rgb(111 192 255 / .20) 53%, transparent 62%);
    filter: blur(6px); opacity: .55; pointer-events: none;
  }
  /* corner vignette keeps the eye on the number */
  .pc-art::after {
    content: ""; position: absolute; inset: 0; pointer-events: none;
    background: radial-gradient(78% 70% at 50% 42%, transparent 48%, rgb(0 0 0 / .62));
  }
  .pc-watermark {
    position: absolute; width: 124%; max-width: none;
    opacity: .07; filter: grayscale(.55) contrast(1.2);
    transform: rotate(-9deg) translateY(4%);
  }
  .pc-art :global(.pc-photo) { position: relative; width: 100%; height: 100%; object-fit: cover; }
  .pc-number {
    position: relative; z-index: 1;
    font-family: var(--font-display); font-style: italic; font-weight: 900;
    font-size: calc(var(--cw) * .56); line-height: .8;
    background: linear-gradient(174deg, #FFFFFF 14%, #DCE6F2 38%, #8E99A8 53%, #F2F6FB 70%, #B9C7DA 100%);
    -webkit-background-clip: text; background-clip: text; color: transparent;
    filter:
      drop-shadow(0 2px 0 rgb(255 255 255 / .22))
      drop-shadow(0 6px 16px rgb(0 0 0 / .85))
      drop-shadow(0 0 26px rgb(28 143 232 / .45));
  }
  .pc-captain {
    position: absolute; top: 8px; left: 8px; z-index: 2;
    display: grid; place-items: center; width: 26px; height: 26px;
    font-family: var(--font-display); font-weight: 900; font-size: .95rem; line-height: 1;
    color: var(--navy-950);
    background: linear-gradient(180deg, #fff, var(--ice-300));
    border-radius: 50%;
    box-shadow: 0 2px 8px rgb(0 0 0 / .5);
  }

  .pc-plate {
    display: flex; flex-direction: column; align-items: center; gap: 1px;
    padding: var(--s-3) var(--s-2) var(--s-3);
    text-align: center;
  }
  .pc-num-sm { font-size: var(--t-xs); color: var(--volt-300); letter-spacing: .06em; }
  .pc-name {
    font-family: var(--font-display); font-style: italic; font-weight: 900;
    font-size: calc(var(--cw) * .098); line-height: 1;
    text-transform: uppercase; letter-spacing: var(--track-tight);
    color: var(--white); text-wrap: balance;
  }
  .pc-role {
    font-family: var(--font-ui); font-size: var(--t-micro); font-weight: 600;
    letter-spacing: .1em; text-transform: uppercase; color: var(--text-dim);
    margin-top: 2px;
  }

  /* Finished art fills the card edge to edge; the generated header, plate and
     inner panel would only repeat what is already printed on it. */
  .pcard--art .pc-head,
  .pcard--art .pc-plate { display: none; }
  .pcard--art .pc-art {
    margin: 0; border: 0; border-radius: calc(var(--r-lg) - 3px);
    background: none; box-shadow: none;
  }
  .pcard--art .pc-art::before,
  .pcard--art .pc-art::after { display: none; }
  /* Real card art is a finished design with the name plate hard against the
     right edge. The frame is 2.5:3.5 but the artwork is 3:4, so object-fit:
     cover shaved the sides off — "OLIVIER LANDRY / FORWARD" rendered as
     "LANDR / FORWAR". Match the frame to the art and contain it, so a future
     card of a different shape letterboxes instead of losing its own name. */
  .pcard--art { aspect-ratio: 3 / 4; }
  .pcard--art picture { display: block; width: 100%; height: 100%; }
  .pcard--art .pc-art :global(.pc-photo) { width: 100%; height: 100%; object-fit: contain; }

  .pcard--goalie { background: linear-gradient(160deg, var(--steel-400) 0%, var(--navy-800) 28%, var(--navy-950) 62%, var(--blue-600) 100%); }
</style>

<script>import "../scripts/player-profiles";</script>
