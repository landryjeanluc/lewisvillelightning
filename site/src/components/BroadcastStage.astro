---
import { sides, roster, type GameEvent } from "../lib/data";
import { time, shortDate } from "../lib/format";
import TeamCrest from "./TeamCrest.astro";

/**
 * The broadcast stage: the stream in a 16:9 frame with our own graphics over it.
 *
 * The frame is the only part of this page we do not control, so nothing is
 * drawn inside it — the overlay is our DOM, positioned above, fed by
 * `/api/broadcast/<game>`. No third-party script is loaded, which is why the
 * Content-Security-Policy only has to allow a frame and not a script origin.
 *
 * Everything scales off the stage's own width (`cqi`), not the viewport, so the
 * same scorebug reads correctly on a phone, on a laptop, and filling a
 * television in fullscreen without a second set of sizes.
 */
interface Props { game: GameEvent }
const { game } = Astro.props;
const s = sides(game);

// Away on the left, home on the right — the same convention as the posters and
// the live scoreboard, so the bug never contradicts the rest of the site.
const left = { team: s.left, side: s.weAreHome ? "them" : "us" };
const right = { team: s.right, side: s.weAreHome ? "us" : "them" };

/**
 * Jersey numbers and names for the goal graphics.
 *
 * Deliberately inlined into this page rather than imported by the overlay
 * script: `tools/check_public_assets.mjs` fails the build if a child's name
 * reaches an unauthenticated bundle under /_astro, and it is right to. This
 * page is served behind the login gate, so the names belong here and nowhere
 * else. `<` is escaped so a name could never close the script element.
 */
const players = Object.fromEntries(
  roster.players.map((p) => [p.id, { n: p.number, first: p.firstName, last: p.lastName }]),
);
const rosterJson = JSON.stringify(players).replace(/</g, "\\u003c");
---
<section
  class="stage"
  data-broadcast={game.id}
  data-we-are-home={s.weAreHome ? "true" : "false"}
  data-starts-at={game.startsAt}
  data-us-short={s.us.short}
  data-them-short={s.them.short}
  aria-label="Broadcast"
>
  <script is:inline type="application/json" data-broadcast-roster set:html={rosterJson} />

  <div class="frame" data-frame>
    <!-- The facade. One tap mounts the frame, which is both a user gesture the
         browser will accept for playback and a promise not to blast arena noise
         at anyone who merely opened the page. -->
    <div class="facade" data-facade>
      <div class="facade-art">
        <TeamCrest team={s.left} size={120} eager />
        <span class="facade-vs display--italic">VS</span>
        <TeamCrest team={s.right} size={120} eager />
      </div>
      <p class="facade-when eyebrow">{shortDate(game.startsAt)} · {time(game.startsAt)} · {game.venue.name}</p>
      <button type="button" class="facade-play" data-play hidden>
        <span class="facade-play-icon" aria-hidden="true"></span>
        <span data-play-label>Watch the broadcast</span>
      </button>
      <p class="facade-note dim" data-facade-note>Checking for a stream…</p>
    </div>
    <div class="holder" data-holder></div>

    <!-- ----------------------------------------------------------- overlay -->
    <div class="ovl" data-overlay>
      <div class="ovl-badge" data-live-badge hidden>
        <span class="ovl-dot" aria-hidden="true"></span><span data-live-text>LIVE</span>
      </div>

      <!-- Full-frame cards: before the drop, between periods, after the horn. -->
      <div class="card" data-card hidden>
        <span class="card-kicker eyebrow" data-card-kicker></span>
        <h2 class="card-title display--italic" data-card-title></h2>
        <p class="card-sub" data-card-sub></p>
        <ol class="card-summary" data-card-summary hidden></ol>
      </div>

      <!-- The scorebug. -->
      <div class="bug" data-bug hidden>
        <div class="bug-main">
          <div class="bug-team" data-bug-side={left.side} style={`--tc:${left.team.colours.primary}`}>
            <TeamCrest team={left.team} size={48} eager />
            <span class="bug-abbr">{left.team.short}</span>
            <strong class="bug-score num" data-score>0</strong>
          </div>

          <div class="bug-mid">
            <span class="bug-period" data-period>1ST</span>
            <strong class="bug-clock num" data-clock>15:00</strong>
            <span class="bug-strength" data-strength hidden>EVEN</span>
          </div>

          <div class="bug-team bug-team--right" data-bug-side={right.side} style={`--tc:${right.team.colours.primary}`}>
            <strong class="bug-score num" data-score>0</strong>
            <span class="bug-abbr">{right.team.short}</span>
            <TeamCrest team={right.team} size={48} eager />
          </div>
        </div>

        <div class="bug-strip">
          <span class="bug-sog">SOG <b class="num" data-sog={left.side}>0</b></span>
          <span class="bug-pp" data-pp hidden><b data-pp-label>PP</b> <b class="num" data-pp-clock>0:00</b></span>
          <span class="bug-sog bug-sog--right">SOG <b class="num" data-sog={right.side}>0</b></span>
        </div>

        <ul class="boxes" data-boxes aria-label="Penalties"></ul>
      </div>

      <!-- Goal graphic. -->
      <div class="l3" data-lower hidden>
        <div class="l3-flag" data-lower-flag></div>
        <div class="l3-body">
          <span class="l3-kicker" data-lower-kicker>GOAL</span>
          <strong class="l3-name display--italic" data-lower-name></strong>
          <span class="l3-detail" data-lower-detail></span>
        </div>
        <span class="l3-stamp num" data-lower-stamp></span>
      </div>
    </div>
  </div>

  <div class="stage-bar">
    <p class="stage-status dim" role="status" data-status></p>
    <div class="stage-actions">
      <button type="button" class="ghost" data-toggle-overlay aria-pressed="true">Hide overlay</button>
      <button type="button" class="ghost" data-fullscreen>Fullscreen</button>
      <a class="ghost stage-link" data-watch-link href="#" rel="noopener noreferrer" target="_blank" hidden>On YouTube ↗</a>
    </div>
  </div>
</section>

<script>import "../scripts/broadcast";</script>

<style>
  /* The stage is the sizing context for every graphic on it, so one set of
     `cqi` sizes covers a phone, a laptop and a television. */
  .stage { container-type: inline-size; }
  .frame {
    position: relative; aspect-ratio: 16 / 9; overflow: hidden;
    border: 1px solid var(--hairline-sv); border-radius: var(--r-lg);
    background:
      radial-gradient(120% 90% at 50% -10%, rgb(28 143 232 / .16), transparent 62%),
      var(--bg-sunken);
    box-shadow: var(--shadow-lg);
  }
  .frame:fullscreen { border: 0; border-radius: 0; aspect-ratio: auto; height: 100dvh; }
  .holder, .holder :global(iframe) {
    position: absolute; inset: 0; width: 100%; height: 100%; border: 0; display: block;
  }

  /* ------------------------------------------------------------- facade */
  .facade {
    position: absolute; inset: 0; z-index: 3;
    display: grid; align-content: center; justify-items: center; gap: 3cqi;
    padding: 4cqi; text-align: center;
  }
  .facade-art { display: flex; align-items: center; gap: 5cqi; }
  .facade-art :global(.tc) { --crest-size: 16cqi; }
  .facade-vs {
    font-family: var(--font-display); font-size: 7cqi; font-weight: 900;
    color: var(--ice-300); opacity: .85;
  }
  .facade-when { font-size: max(0.6875rem, 1.6cqi); }
  .facade-play {
    display: inline-flex; align-items: center; gap: var(--s-3);
    padding: var(--s-3) var(--s-5); font-size: max(0.9375rem, 2cqi);
  }
  .facade-play-icon {
    width: 0; height: 0; border-style: solid; border-width: .45em 0 .45em .78em;
    border-color: transparent transparent transparent currentColor;
  }
  .facade-note { font-size: max(0.8125rem, 1.6cqi); }

  /* ------------------------------------------------------------ overlay */
  /* Pointer-events off so the layer never swallows a tap meant for the player;
     anything interactive turns them back on for itself. */
  .ovl { position: absolute; inset: 0; z-index: 2; pointer-events: none; }
  .stage[data-overlay-off] .ovl { display: none; }

  .ovl-badge {
    position: absolute; top: 2.4cqi; left: 2.4cqi;
    display: flex; align-items: center; gap: .8cqi;
    padding: .7cqi 1.5cqi; border-radius: 999px;
    background: rgb(4 8 20 / .72); backdrop-filter: blur(6px);
    border: 1px solid rgb(255 77 77 / .5);
    font-family: var(--font-ui); font-weight: 700; font-size: max(0.625rem, 1.5cqi);
    letter-spacing: var(--track-label); text-transform: uppercase; color: var(--white);
  }
  .ovl-dot {
    width: 1.1cqi; height: 1.1cqi; min-width: 6px; min-height: 6px; border-radius: 50%;
    background: var(--live); box-shadow: 0 0 1.5cqi rgb(255 77 77 / .9);
    animation: pulse 2s var(--ease) infinite;
  }
  @keyframes pulse { 50% { opacity: .35; } }

  /* -------------------------------------------------------------- bug */
  .bug {
    position: absolute; left: 50%; bottom: 2.6cqi; transform: translateX(-50%);
    min-width: 54cqi; display: grid;
    font-family: var(--font-ui);
    /* The sheen, the hairline and the dark glass are what make a flat div read
       as a piece of broadcast furniture rather than a web widget. */
    background:
      linear-gradient(180deg, rgb(255 255 255 / .09), transparent 42%),
      linear-gradient(180deg, rgb(10 17 40 / .93), rgb(4 8 20 / .96));
    border: 1px solid rgb(173 191 215 / .22);
    border-radius: var(--r-md);
    box-shadow: 0 2cqi 5cqi -1cqi rgb(0 0 0 / .8), inset 0 1px 0 rgb(255 255 255 / .16);
    backdrop-filter: blur(8px) saturate(130%);
    overflow: hidden;
  }
  .bug-main { display: grid; grid-template-columns: 1fr auto 1fr; align-items: stretch; }
  .bug-team {
    display: flex; align-items: center; gap: 1.6cqi;
    padding: 1.4cqi 2cqi;
    /* A wash of the club's own colour, so the two sides are told apart at a
       glance even on a phone where the crest is only a few millimetres wide. */
    background: linear-gradient(90deg, color-mix(in srgb, var(--tc) 46%, transparent), transparent 88%);
  }
  .bug-team--right {
    justify-content: flex-end;
    background: linear-gradient(270deg, color-mix(in srgb, var(--tc) 46%, transparent), transparent 88%);
  }
  .bug-team :global(.tc) { --crest-size: 6cqi; min-width: 22px; }
  .bug-abbr {
    font-weight: 700; font-size: max(0.6875rem, 2cqi); letter-spacing: .06em;
    text-transform: uppercase; color: var(--white); white-space: nowrap;
    overflow: hidden; text-overflow: ellipsis;
  }
  .bug-score {
    font-size: max(1.5rem, 5cqi); line-height: 1; color: var(--white);
    margin-left: auto; text-shadow: 0 .3cqi 1.2cqi rgb(0 0 0 / .8);
  }
  .bug-team--right .bug-score { margin: 0 auto 0 0; }

  .bug-mid {
    display: grid; justify-items: center; align-content: center; gap: .3cqi;
    padding: 1.2cqi 2.2cqi; min-width: 16cqi;
    background: linear-gradient(180deg, rgb(28 143 232 / .20), rgb(4 8 20 / .5));
    border-inline: 1px solid rgb(173 191 215 / .22);
  }
  .bug-period {
    font-size: max(0.5625rem, 1.5cqi); font-weight: 700;
    letter-spacing: var(--track-label); text-transform: uppercase; color: var(--volt-300);
  }
  .bug-clock {
    font-size: max(1.125rem, 3.6cqi); line-height: 1; color: var(--white);
    font-variant-numeric: tabular-nums;
  }
  .bug[data-ticking] .bug-clock { color: #fff; text-shadow: 0 0 2cqi rgb(28 143 232 / .5); }
  .bug-strength {
    font-size: max(0.5rem, 1.3cqi); font-weight: 700; letter-spacing: .14em;
    text-transform: uppercase; color: var(--volt-400);
  }

  .bug-strip {
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center;
    gap: 1cqi; padding: .7cqi 2cqi;
    border-top: 1px solid rgb(173 191 215 / .16);
    background: rgb(2 5 14 / .55);
    font-size: max(0.5rem, 1.3cqi); font-weight: 700;
    letter-spacing: .12em; text-transform: uppercase; color: var(--steel-400);
  }
  .bug-strip b { color: var(--ice-200); }
  .bug-sog--right { text-align: right; }
  .bug-pp { color: var(--volt-300); }
  .bug-pp b { color: var(--volt-300); }

  .boxes { display: grid; gap: .4cqi; list-style: none; margin: 0; padding: 0; }
  .boxes:not(:empty) { padding: .8cqi 2cqi 1.1cqi; border-top: 1px solid rgb(173 191 215 / .16); }
  .boxes :global(li) {
    display: flex; align-items: center; gap: 1.2cqi;
    font-size: max(0.5rem, 1.3cqi); font-weight: 700;
    letter-spacing: .08em; text-transform: uppercase; color: var(--ice-200);
  }
  .boxes :global(li .bx-tag) {
    padding: .1cqi .8cqi; border-radius: var(--r-sm);
    background: var(--surface-2); border: 1px solid var(--hairline);
    color: var(--white);
  }
  .boxes :global(li[data-side="them"] .bx-tag) { color: var(--volt-300); }
  .boxes :global(li .bx-clock) { margin-left: auto; font-variant-numeric: tabular-nums; color: #fff; }

  /* ------------------------------------------------------ lower third */
  .l3 {
    position: absolute; left: 2.6cqi; bottom: 2.6cqi; right: 2.6cqi;
    display: flex; align-items: stretch; gap: 0; overflow: hidden;
    border-radius: var(--r-md);
    background: linear-gradient(90deg, rgb(11 29 84 / .97), rgb(4 8 20 / .95));
    border: 1px solid rgb(173 191 215 / .24);
    box-shadow: 0 2cqi 6cqi -1cqi rgb(0 0 0 / .85);
    animation: l3in .5s var(--ease-out-back) both;
  }
  .l3[data-leaving] { animation: l3out .35s var(--ease) both; }
  @keyframes l3in  { from { transform: translateY(130%); opacity: 0; } }
  @keyframes l3out { to   { transform: translateY(130%); opacity: 0; } }
  .l3-flag { width: 1.2cqi; background: var(--volt-500); box-shadow: var(--glow-volt); }
  .l3-body { display: grid; gap: .2cqi; padding: 1.4cqi 2.2cqi; min-width: 0; }
  .l3-kicker {
    font-family: var(--font-ui); font-size: max(0.5625rem, 1.5cqi); font-weight: 700;
    letter-spacing: var(--track-label); text-transform: uppercase; color: var(--volt-300);
  }
  .l3-name {
    font-size: max(1.125rem, 4cqi); line-height: .95; color: var(--white);
    text-transform: uppercase;
  }
  .l3-detail { font-size: max(0.625rem, 1.6cqi); color: var(--ice-300); }
  .l3-stamp {
    margin-left: auto; align-self: center; padding-right: 2.2cqi;
    font-size: max(0.625rem, 1.8cqi); color: var(--steel-400); white-space: nowrap;
  }

  /* ------------------------------------------------------------- cards */
  .card {
    position: absolute; inset: 0; z-index: 1;
    display: grid; align-content: center; justify-items: center; gap: 1.4cqi;
    padding: 5cqi; text-align: center;
    background:
      radial-gradient(90% 70% at 50% 0%, rgb(28 143 232 / .22), transparent 65%),
      linear-gradient(180deg, rgb(4 8 20 / .90), rgb(2 5 14 / .96));
    backdrop-filter: blur(3px);
  }
  .card-kicker { font-size: max(0.625rem, 1.8cqi); }
  .card-title {
    font-size: max(1.75rem, 8cqi); line-height: .9;
    background: linear-gradient(180deg, #fff 34%, var(--ice-300) 76%, var(--steel-400));
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .card-sub { font-size: max(0.875rem, 2.2cqi); color: var(--ice-300); }
  .card-summary {
    display: grid; gap: .6cqi; margin-top: 1.4cqi; padding: 0; list-style: none;
    font-size: max(0.6875rem, 1.6cqi); color: var(--ice-200); text-align: left;
  }
  .card-summary :global(li) { display: flex; gap: 1.4cqi; }
  .card-summary :global(li .cs-stamp) { color: var(--steel-400); font-variant-numeric: tabular-nums; }

  /* -------------------------------------------------------- stage bar */
  .stage-bar {
    display: flex; align-items: center; justify-content: space-between;
    flex-wrap: wrap; gap: var(--s-3); margin-top: var(--s-4);
  }
  .stage-status { font-size: var(--t-sm); }
  .stage-actions { display: flex; gap: var(--s-3); flex-wrap: wrap; margin-left: auto; }
  .stage-link { text-decoration: none; display: inline-flex; align-items: center; }

  @container (max-width: 560px) {
    /* On a phone the frame is only about 220px tall, and the full bug was
       taking half the picture. The scorebug exists to annotate the ice, not to
       replace it: the penalty rows go, since the strip already carries the one
       thing that matters live — who is on the power play and for how long —
       and everything else draws in to roughly a quarter of the height. */
    .bug { min-width: 0; left: 1.6cqi; right: 1.6cqi; bottom: 1.6cqi; transform: none; }
    .bug-team { padding: 1cqi 1.6cqi; gap: 1.2cqi; }
    .bug-team :global(.tc) { --crest-size: 5cqi; min-width: 18px; }
    .bug-abbr { font-size: max(0.625rem, 2.6cqi); }
    .bug-score { font-size: max(1.25rem, 5cqi); }
    .bug-mid { padding: .8cqi 1.6cqi; }
    .bug-clock { font-size: max(1rem, 3.6cqi); }
    .bug-strip { padding: .45cqi 1.6cqi; }
    .boxes { display: none; }
  }
</style>
