---
interface Props { id: string; }
const { id } = Astro.props;
---
<button type="button" id={id} class="play-fullscreen-button" aria-label="Enter full screen" title="Enter full screen" aria-pressed="false">
  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <path class="play-expand-icon" d="M9 3H3v6m12-6h6v6M3 15v6h6m12-6v6h-6" />
    <path class="play-collapse-icon" d="M3 9h6V3m6 0v6h6M9 21v-6H3m12 6v-6h6" />
  </svg>
  <span>Full screen</span>
</button>
