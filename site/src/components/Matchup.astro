---
import TeamCrest from "./TeamCrest.astro";
import { type GameEvent } from "../lib/data";
import { sides } from "../lib/data";

interface Props { game: GameEvent; size?: "hero" | "compact" }
const { game, size = "hero" } = Astro.props;
const { left, right, weAreHome } = sides(game);
const showScore = game.status === "final" || game.status === "in_progress";
---
<div class:list={["matchup", `matchup--${size}`]}>
  <div class="side side--left" style={`--team: ${left.colours.primary}; --team-2: ${left.colours.secondary}`}>
    <div class="glow" aria-hidden="true"></div>
    <TeamCrest team={left} eager />
    <div class="label">
      <span class="town">{left.name.replace(new RegExp(`\\s*${left.short}$`), "")}</span>
      <span class="nick">{left.short}</span>
    </div>
    {showScore && <span class="score num">{game.away.score ?? "—"}</span>}
  </div>

  <div class="vs" aria-hidden="true">
    <svg class="fissure" viewBox="0 0 40 400" preserveAspectRatio="none">
      <path d="M22 0 L14 118 L26 150 L10 268 L22 300 L13 400"
            fill="none" stroke="url(#fg)" stroke-width="2.5" stroke-linejoin="miter" />
      <defs>
        <linearGradient id="fg" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%"   stop-color="#1C8FE8" stop-opacity="0" />
          <stop offset="28%"  stop-color="#6FC0FF" stop-opacity=".9" />
          <stop offset="72%"  stop-color="#6FC0FF" stop-opacity=".9" />
          <stop offset="100%" stop-color="#1C8FE8" stop-opacity="0" />
        </linearGradient>
      </defs>
    </svg>
    <span class="vs-text">VS</span>
  </div>

  <div class="side side--right" style={`--team: ${right.colours.primary}; --team-2: ${right.colours.secondary}`}>
    <div class="glow" aria-hidden="true"></div>
    <TeamCrest team={right} eager />
    <div class="label">
      <span class="town">{right.name.replace(new RegExp(`\\s*${right.short}$`), "")}</span>
      <span class="nick">{right.short}</span>
    </div>
    {showScore && <span class="score num">{game.home.score ?? "—"}</span>}
  </div>
</div>

<p class="visually-hidden">
  {weAreHome ? "Home game" : "Away game"}. {left.name} versus {right.name}.
</p>

<style>
  /* Scale is driven by one knob so the poster renderer can reuse this
     component at 3840px by overriding --u. */
  .matchup {
    --u: clamp(0.62rem, 0.2rem + 1.5vw, 1.1rem);
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: calc(var(--u) * 1.5);
    position: relative;
  }
  .matchup--compact { --u: 0.5rem; }

  .side {
    position: relative;
    display: flex; flex-direction: column; align-items: center;
    gap: calc(var(--u) * 0.9);
    padding-block: calc(var(--u) * 1.2);
    isolation: isolate;
  }
  .glow {
    position: absolute; inset: -12% -6%; z-index: -1;
    background: radial-gradient(60% 55% at 50% 45%,
      color-mix(in srgb, var(--team) 55%, transparent), transparent 72%);
    filter: blur(calc(var(--u) * 1.6));
    opacity: .75;
  }
  .side :global(.tc) {
    --crest-size: calc(var(--u) * 15);
    max-width: 100%;
    filter: drop-shadow(0 calc(var(--u) * .5) calc(var(--u) * 1.4) rgb(0 0 0 / .6));
  }
  .matchup--compact .side :global(.tc) { --crest-size: calc(var(--u) * 7); }

  .label { min-width: 0; max-width: 100%; display: flex; flex-direction: column; align-items: center; text-align: center; line-height: 1; }
  .town {
    font-family: var(--font-ui);
    font-size: calc(var(--u) * 1.15);
    font-weight: 700; letter-spacing: var(--track-label); text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: calc(var(--u) * .4);
  }
  .nick {
    font-family: var(--font-display); font-style: italic; font-weight: 900;
    font-size: calc(var(--u) * 3.1);
    letter-spacing: var(--track-tight); text-transform: uppercase;
    background: linear-gradient(180deg, #fff 30%, var(--ice-300));
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .score {
    font-size: calc(var(--u) * 3.6); line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .vs { position: relative; display: grid; place-items: center; align-self: stretch; min-width: calc(var(--u) * 4); }
  .fissure { position: absolute; inset: 0; width: 100%; height: 100%; opacity: .85; }
  .vs-text {
    font-family: var(--font-display); font-style: italic; font-weight: 900;
    font-size: calc(var(--u) * 2.4);
    letter-spacing: var(--track-tight);
    color: var(--white);
    text-shadow: 0 0 calc(var(--u) * 1.4) rgb(28 143 232 / .8);
    padding: calc(var(--u) * .3) calc(var(--u) * .5);
    background: color-mix(in srgb, var(--bg) 70%, transparent);
    border-radius: var(--r-sm);
  }

  @media (max-width: 520px) {
    .matchup { gap: calc(var(--u) * .6); }
    .side :global(.tc) { --crest-size: calc(var(--u) * 11); }
  }
  @media (max-width: 400px) {
    .matchup--hero { --u: .55rem; }
    .nick { font-size: calc(var(--u) * 2.6); }
    .town { letter-spacing: .08em; }
    .vs { min-width: calc(var(--u) * 2.8); }
  }
</style>
