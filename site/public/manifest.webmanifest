{
  "id": "/",
  "name": "Lewisville Lightning",
  "short_name": "Lightning",
  "description": "Schedule, roster, stats, plays of the week and team chat for the Lewisville Lightning.",
  "lang": "en-CA",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "background_color": "#040814",
  "theme_color": "#040814",
  "categories": ["sports"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Schedule", "url": "/schedule", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Team chat", "url": "/chat", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Plays", "url": "/plays", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
